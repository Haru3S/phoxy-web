---
import ContactVisual from './ContactVisual.astro';
import ContactMessage from './ContactMessage.astro';

import '../../styles/contact/contact.css';
---

<section
  id="contact"
  class="contact-section"
>
  <header class="contact-header">
    <h2>
      <span
        class="lens-text lens-interactive scroll-emphasis"
        data-text="Contact"
        data-scroll-emphasis
      >
        Contact
      </span>
    </h2>
  </header>

  <div
    class="contact-rule"
    aria-hidden="true"
  ></div>

  <div class="contact-grid">
    <div class="contact-visual-column">
      <ContactVisual />
    </div>

    <div class="contact-information">
      <div class="contact-primary">
        <button
          class="contact-email"
          type="button"
          data-contact-message-open
          aria-haspopup="dialog"
        >
          <span class="contact-email-text">
            Email Me
          </span>

          <i
            class="ph ph-paper-plane-tilt"
            aria-hidden="true"
          ></i>
        </button>

        <p class="contact-description">
          Got a question, project,
          opportunity, or just something
          worth talking about? Throw it
          my way.
        </p>
      </div>

      <div class="contact-footer">
        <div class="contact-status-meta">
          <time
            data-phoxy-time
            datetime=""
          >
            --:-- | --:-- -- CDT
          </time>

          <span>
            Email
          </span>
        </div>

        <div class="contact-status">
          <span
            class="contact-status-dot"
            aria-hidden="true"
          ></span>

          <span>
            Open
          </span>
        </div>
      </div>
    </div>
  </div>

  <div
    class="contact-rule"
    aria-hidden="true"
  ></div>
</section>

<ContactMessage />

<script>
  import '../../scripts/contact.ts';
</script>