---
import '../../styles/hero/hero.css';
---

<section
  class="hero"
  aria-labelledby="hero-title"
  data-hero
>
  <div
    class="hero-canvas"
    data-hero-canvas
  >
    <div class="hero-fill"></div>

    <img
      class="hero-layer hero-wall"
      src="/assets/hero/wall-texture.webp"
      alt=""
    />

    <img
      class="hero-layer hero-graffiti"
      src="/assets/hero/phoxy-graffiti.webp"
      alt=""
      data-hero-graffiti
    />

    <button
      class="scout-button"
      type="button"
      aria-label="Play a random Scout voice line"
      data-scout-button
    >
      <img
        class="hero-layer hero-scout"
        src="/assets/hero/scout.webp"
        alt=""
        data-hero-scout
      />
    </button>
  </div>

  <button
    class="hero-scroll-indicator"
    type="button"
    aria-label="Scroll to Who I Am"
    data-hero-scroll
  >
    <i
      class="ph ph-caret-down"
      aria-hidden="true"
    ></i>
  </button>

  <h1
    id="hero-title"
    class="sr-only"
  >
    Phoxy
  </h1>
</section>

<script>
  import '../../scripts/hero.ts';
</script>