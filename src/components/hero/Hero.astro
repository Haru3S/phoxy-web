<section class="hero" aria-labelledby="hero-title">
  <div class="hero-canvas">
    <div class="hero-fill"></div>

    <img
      class="hero-layer hero-wall"
      src="/assets/hero/wall-texture.webp"
      alt=""
    />

    <img
      class="hero-layer hero-graffiti"
      src="/assets/hero/phoxy-graffiti.webp"
      alt=""
    />

    <button
      class="scout-button"
      type="button"
      aria-label="Play a random Scout voice line"
    >
      <img
        class="hero-layer hero-scout"
        src="/assets/hero/scout.webp"
        alt=""
      />
    </button>
  </div>

  <h1 id="hero-title" class="sr-only">Phoxy</h1>
</section>

<style>
  .hero {
    width: 100%;
    overflow: hidden;
    background: #FF9500;
  }

  .hero-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .hero-fill,
  .hero-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-fill {
    background: #DF9800;
  }

  .hero-layer {
    object-fit: contain;
    user-select: none;
    pointer-events: none;
  }

  .hero-wall {
    mix-blend-mode: screen;
  }

  .scout-button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;

    padding: 0;
    border: 0;
    background: transparent;

    cursor: pointer;
  }

  .hero-scout {
    pointer-events: none;
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero-canvas');
  const graffiti = document.querySelector<HTMLElement>('.hero-graffiti');
  const scout = document.querySelector<HTMLElement>('.hero-scout');
  const scoutButton =
    document.querySelector<HTMLButtonElement>('.scout-button');

  /*
   * HERO PARALLAX
   */

  if (hero && graffiti && scout) {
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    const updateTarget = (event: PointerEvent) => {
      if (reducedMotion.matches) return;

      const rect = hero.getBoundingClientRect();

      targetX =
        ((event.clientX - rect.left) / rect.width - 0.5) * 2;

      targetY =
        ((event.clientY - rect.top) / rect.height - 0.5) * 2;
    };

    const resetTarget = () => {
      targetX = 0;
      targetY = 0;
    };

    const animate = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      graffiti.style.transform =
        `translate(${currentX * 3}px, ${currentY * 3}px)`;

      scout.style.transform =
        `translate(${currentX * 7}px, ${currentY * 7}px)`;

      requestAnimationFrame(animate);
    };

    hero.addEventListener('pointermove', updateTarget);
    hero.addEventListener('pointerleave', resetTarget);

    animate();
  }

  /*
   * SCOUT VOICE LINES
   */

  const scoutLines = [
    '/audio/scout/scout_award12.mp3',
    '/audio/scout/scout_cheers06.mp3',
    '/audio/scout/scout_generic01.mp3',
    '/audio/scout/scout_invincible03.mp3',
    '/audio/scout/scout_meleedare04.mp3',
    '/audio/scout/scout_positivevocalization01.mp3',
    '/audio/scout/scout_positivevocalization04.mp3',
    '/audio/scout/scout_revenge07.mp3',
    '/audio/scout/scout_specialcompleted06.mp3',
  ];

  let previousLine = -1;
  let currentAudio: HTMLAudioElement | null = null;

  const playRandomScoutLine = () => {
    if (scoutLines.length === 0) return;

    let nextLine = previousLine;

    while (
      nextLine === previousLine &&
      scoutLines.length > 1
    ) {
      nextLine = Math.floor(
        Math.random() * scoutLines.length
      );
    }

    if (scoutLines.length === 1) {
      nextLine = 0;
    }

    previousLine = nextLine;

    if (currentAudio) {
      currentAudio.pause();
      currentAudio.currentTime = 0;
    }

    currentAudio = new Audio(scoutLines[nextLine]);

    // 0.0 = silent, 1.0 = original volume
    // 0.5 is approximately -6 dB.
    currentAudio.volume = 0.5;

    currentAudio.play().catch((error) => {
      console.error(
        'Could not play Scout voice line:',
        error
      );
    });
  };

  scoutButton?.addEventListener(
    'click',
    playRandomScoutLine
  );
</script>