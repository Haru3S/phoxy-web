<section
  class="hero"
  aria-labelledby="hero-title"
  data-hero
>
  <div class="hero-canvas">
    <div class="hero-fill"></div>

    <img
      class="hero-layer hero-wall"
      src="/assets/hero/wall-texture.webp"
      alt=""
    />

    <img
      class="hero-layer hero-graffiti"
      src="/assets/hero/phoxy-graffiti.webp"
      alt=""
    />

    <button
      class="scout-button"
      type="button"
      aria-label="Play a random Scout voice line"
    >
      <img
        class="hero-layer hero-scout"
        src="/assets/hero/scout.webp"
        alt=""
      />
    </button>
  </div>

  <button
    class="hero-scroll-indicator"
    type="button"
    aria-label="Scroll to Who I Am"
    data-hero-scroll
  >
    <i
      class="ph ph-caret-down"
      aria-hidden="true"
    ></i>
  </button>

  <h1 id="hero-title" class="sr-only">Phoxy</h1>
</section>

<style>
  .hero {
    width: 100%;

    overflow: hidden;

    background: #FF9500;
  }

  .hero-canvas {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    overflow: hidden;
  }

  .hero-fill,
  .hero-layer {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;
  }

  .hero-fill {
    background: #000;
  }

  .hero-layer {
    object-fit: contain;

    user-select: none;
    pointer-events: none;
  }

  .hero-wall {
    mix-blend-mode: screen;
  }


  /*
   * SCOUT
   */

  .scout-button {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    padding: 0;
    border: 0;

    background: transparent;

    cursor: pointer;
  }

  .hero-scout {
    pointer-events: none;
  }


  /*
   * HERO SCROLL INDICATOR
   *
   * The Hero itself is a true 16:9 canvas,
   * which can extend below the viewport.
   *
   * The scroll affordance therefore belongs
   * to the viewport rather than the bottom
   * edge of the Hero artwork.
   */

  .hero-scroll-indicator {
    position: fixed;

    left: 50%;

    bottom:
      clamp(
        3rem,
        5vh,
        4rem
      );

    z-index: 100;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 2.75rem;
    height: 2.75rem;

    padding: 0;

    border:
      1px
      solid
      rgba(255, 255, 255, 0.28);

    border-radius: 50%;

    background:
      rgba(0, 0, 0, 0.38);

    color:
      rgba(255, 255, 255, 0.7);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    transform:
      translateX(-50%);

    opacity: 1;
    visibility: visible;

    cursor: pointer;

    transition:
      opacity 0.25s ease-out,
      color 0.15s ease-out,
      border-color 0.15s ease-out,
      transform 0.15s ease-out,
      visibility 0s linear 0s;
  }

  .hero-scroll-indicator:hover,
  .hero-scroll-indicator:focus-visible {
    color:
      rgba(255, 255, 255, 1);

    border-color:
      rgba(255, 255, 255, 0.7);

    transform:
      translateX(-50%)
      translateY(0.15rem);
  }

  .hero-scroll-indicator i {
    font-size: 1.4rem;
  }


  /*
   * HIDDEN STATE
   */

  .hero-scroll-indicator.is-hidden {
    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 0.25s ease-out,
      color 0.15s ease-out,
      border-color 0.15s ease-out,
      transform 0.15s ease-out,
      visibility 0s linear 0.25s;
  }


  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-indicator,
    .hero-scroll-indicator.is-hidden {
      transition: none;
    }

    .hero-scroll-indicator:hover,
    .hero-scroll-indicator:focus-visible {
      transform:
        translateX(-50%);
    }
  }
</style>

<script>
  const hero =
    document.querySelector<HTMLElement>(
      '.hero-canvas'
    );

  const heroSection =
    document.querySelector<HTMLElement>(
      '[data-hero]'
    );

  const graffiti =
    document.querySelector<HTMLElement>(
      '.hero-graffiti'
    );

  const scout =
    document.querySelector<HTMLElement>(
      '.hero-scout'
    );

  const scoutButton =
    document.querySelector<HTMLButtonElement>(
      '.scout-button'
    );

  const heroScrollIndicator =
    document.querySelector<HTMLButtonElement>(
      '[data-hero-scroll]'
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );


  /*
   * HERO PARALLAX
   *
   * Pointer position becomes a normalized
   * value from -1 to +1 across the Hero.
   *
   * Horizontal travel is deliberately stronger
   * than vertical travel so the composition
   * responds more clearly to side-to-side
   * movement without feeling like it is floating.
   *
   * Smoothing is based on elapsed time rather
   * than frames. This keeps the movement
   * consistent across different refresh rates
   * and makes large displays feel substantially
   * less stepped or jagged.
   */

  if (hero && graffiti && scout) {
    const GRAFFITI_X = 7;
    const GRAFFITI_Y = 4;

    const SCOUT_X = 15;
    const SCOUT_Y = 8;

    /*
     * Higher value = follows the pointer faster.
     *
     * This is expressed as response speed rather
     * than "percentage per frame", so it behaves
     * consistently at different frame rates.
     */

    const FOLLOW_SPEED = 8;

    let targetX = 0;
    let targetY = 0;

    let currentX = 0;
    let currentY = 0;

    let previousTime:
      number | null = null;


    const updateTarget = (
      event: PointerEvent
    ) => {
      if (reducedMotion.matches) {
        return;
      }

      const rect =
        hero.getBoundingClientRect();

      targetX =
        (
          (
            event.clientX -
            rect.left
          ) /
          rect.width -
          0.5
        ) *
        2;

      targetY =
        (
          (
            event.clientY -
            rect.top
          ) /
          rect.height -
          0.5
        ) *
        2;

      /*
       * Keep the target bounded even if the
       * pointer event lands fractionally beyond
       * the element's measured edge.
       */

      targetX =
        Math.max(
          -1,
          Math.min(
            1,
            targetX
          )
        );

      targetY =
        Math.max(
          -1,
          Math.min(
            1,
            targetY
          )
        );
    };


    const resetTarget = () => {
      targetX = 0;
      targetY = 0;
    };


    const animate = (
      time: number
    ) => {
      if (previousTime === null) {
        previousTime = time;
      }

      /*
       * Clamp very large frame gaps.
       *
       * This prevents the artwork from snapping
       * after switching tabs, resizing, or a
       * temporary browser stall.
       */

      const deltaTime =
        Math.min(
          (time - previousTime) /
            1000,
          0.05
        );

      previousTime = time;


      /*
       * Exponential smoothing.
       *
       * This produces approximately the same
       * response regardless of whether the
       * browser is rendering at 60, 120, 144,
       * or another refresh rate.
       */

      const smoothing =
        1 -
        Math.exp(
          -FOLLOW_SPEED *
          deltaTime
        );


      currentX +=
        (
          targetX -
          currentX
        ) *
        smoothing;

      currentY +=
        (
          targetY -
          currentY
        ) *
        smoothing;


      /*
       * The graffiti sits closer to the wall,
       * so it moves less.
       */

      graffiti.style.transform =
        `translate3d(
          ${currentX * GRAFFITI_X}px,
          ${currentY * GRAFFITI_Y}px,
          0
        )`;


      /*
       * Scout is the foreground layer and gets
       * the strongest movement.
       */

      scout.style.transform =
        `translate3d(
          ${currentX * SCOUT_X}px,
          ${currentY * SCOUT_Y}px,
          0
        )`;


      requestAnimationFrame(
        animate
      );
    };


    hero.addEventListener(
      'pointermove',
      updateTarget,
      { passive: true }
    );

    hero.addEventListener(
      'pointerleave',
      resetTarget
    );

    requestAnimationFrame(
      animate
    );
  }


  /*
   * HERO SCROLL INDICATOR
   */

  if (
    heroSection &&
    heroScrollIndicator
  ) {
    const updateHeroScrollIndicator = () => {
      const rect =
        heroSection.getBoundingClientRect();

      const viewportHeight =
        window.innerHeight;

      const shouldHide =
        rect.bottom <=
        viewportHeight;

      heroScrollIndicator.classList.toggle(
        'is-hidden',
        shouldHide
      );
    };


    heroScrollIndicator.addEventListener(
      'click',
      () => {
        const about =
          document.querySelector<HTMLElement>(
            '#about'
          );

        if (!about) {
          return;
        }

        about.scrollIntoView({
          behavior:
            reducedMotion.matches
              ? 'auto'
              : 'smooth',

          block: 'start',
        });
      }
    );


    let scrollFrame:
      number | null = null;

    const requestIndicatorUpdate = () => {
      if (scrollFrame !== null) {
        return;
      }

      scrollFrame =
        requestAnimationFrame(() => {
          updateHeroScrollIndicator();

          scrollFrame = null;
        });
    };


    window.addEventListener(
      'scroll',
      requestIndicatorUpdate,
      { passive: true }
    );

    window.addEventListener(
      'resize',
      requestIndicatorUpdate
    );

    updateHeroScrollIndicator();
  }


  /*
   * SCOUT VOICE LINES
   */

  const scoutLines = [
    '/audio/scout/scout_award12.mp3',
    '/audio/scout/scout_cheers06.mp3',
    '/audio/scout/scout_generic01.mp3',
    '/audio/scout/scout_invincible03.mp3',
    '/audio/scout/scout_meleedare04.mp3',
    '/audio/scout/scout_positivevocalization01.mp3',
    '/audio/scout/scout_positivevocalization04.mp3',
    '/audio/scout/scout_revenge07.mp3',
    '/audio/scout/scout_specialcompleted06.mp3',
  ];

  let previousLine = -1;

  let currentAudio:
    HTMLAudioElement | null = null;


  const playRandomScoutLine = () => {
    if (scoutLines.length === 0) {
      return;
    }

    let nextLine =
      previousLine;

    while (
      nextLine === previousLine &&
      scoutLines.length > 1
    ) {
      nextLine =
        Math.floor(
          Math.random() *
          scoutLines.length
        );
    }

    if (scoutLines.length === 1) {
      nextLine = 0;
    }

    previousLine =
      nextLine;

    if (currentAudio) {
      currentAudio.pause();

      currentAudio.currentTime = 0;
    }

    currentAudio =
      new Audio(
        scoutLines[nextLine]
      );

    currentAudio.volume = 0.5;

    currentAudio
      .play()
      .catch((error) => {
        console.error(
          'Could not play Scout voice line:',
          error
        );
      });
  };


  scoutButton?.addEventListener(
    'click',
    playRandomScoutLine
  );
</script>