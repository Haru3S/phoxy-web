---
import '../../styles/footer.css';

const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';

const year =
  new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Signature -->
  <div
    class="footer-signature"
    aria-hidden="true"
  >
    <span
      class="lens-text"
      data-text="PHOXY"
    >
      PHOXY
    </span>
  </div>

  <!-- Navigation -->
  <div class="footer-navigation">
    <nav
      class="footer-links"
      aria-label="Footer navigation"
    >
      <a href={base}>
        Home
      </a>

      <a href={`${base}links`}>
        Links
      </a>

      <a href={`${base}support`}>
        Support
      </a>

      <a href="#contact">
        Contact
      </a>
    </nav>

    <a
      class="footer-top"
      href="#top"
    >
      <i
        class="ph ph-arrow-up"
        aria-hidden="true"
      ></i>

      <span>Back to top</span>
    </a>
  </div>

  <!-- Colophon -->
  <div class="footer-meta">
    <span>
      © {year} Phoxy Fox
    </span>

    <span>
      Built with Astro
    </span>
  </div>
</footer>