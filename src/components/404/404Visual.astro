<canvas
  class="not-found-visual"
  data-not-found-visual
  aria-hidden="true"
></canvas>

<script>
  const canvas =
    document.querySelector<HTMLCanvasElement>(
      '[data-not-found-visual]'
    );

  const context =
    canvas?.getContext('2d');

  const reducedMotionQuery =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  interface DustParticle {
    x: number;
    y: number;

    velocityX: number;
    velocityY: number;

    drift: number;
    driftSpeed: number;

    character: string;

    opacity: number;
    size: number;

    flickerOffset: number;
  }

  interface PointerState {
    x: number;
    y: number;

    targetX: number;
    targetY: number;

    active: boolean;
  }

  const dustCharacters = [
    '.',
    '.',
    '.',
    '·',
    '·',
    ':',
    '*',
    '+',
  ];


  /*
   * CURSOR WIND
   *
   * The cursor influences the dust in two ways:
   *
   * 1. Its horizontal position creates a subtle
   *    page-wide wind bias.
   *
   * 2. Dust close to the cursor is pushed away
   *    by a soft radial pressure field.
   *
   * Both forces are now twice as strong as the
   * original interaction.
   */

  const GLOBAL_WIND_STRENGTH = 6.5;

  const POINTER_FIELD_RADIUS = 190;
  const POINTER_FIELD_FORCE = 18;

  const POINTER_SMOOTHING = 8;


  let width = 0;
  let height = 0;

  let pixelRatio = 1;

  let particles: DustParticle[] = [];

  let animationFrame = 0;
  let previousTime = 0;


  /*
   * Start the pointer in the middle so the
   * page has no directional wind before the
   * user interacts with it.
   */

  const pointer: PointerState = {
    x: 0,
    y: 0,

    targetX: 0,
    targetY: 0,

    active: false,
  };


  const randomBetween = (
    minimum: number,
    maximum: number
  ) => {
    return (
      minimum +
      Math.random() *
        (maximum - minimum)
    );
  };


  const randomCharacter = () => {
    return dustCharacters[
      Math.floor(
        Math.random() *
        dustCharacters.length
      )
    ];
  };


  const createParticle = (
    randomY = true
  ): DustParticle => {
    return {
      x:
        Math.random() *
        width,

      y:
        randomY
          ? Math.random() *
            height
          : randomBetween(
              -40,
              -5
            ),

      velocityX:
        randomBetween(
          -4,
          4
        ),

      velocityY:
        randomBetween(
          5,
          18
        ),

      drift:
        Math.random() *
        Math.PI *
        2,

      driftSpeed:
        randomBetween(
          0.25,
          0.8
        ),

      character:
        randomCharacter(),

      opacity:
        randomBetween(
          0.08,
          0.48
        ),

      size:
        randomBetween(
          8,
          15
        ),

      flickerOffset:
        Math.random() *
        Math.PI *
        2,
    };
  };


  const getParticleCount = () => {
    const area =
      width *
      height;

    return Math.max(
      45,
      Math.min(
        180,
        Math.round(
          area /
          10500
        )
      )
    );
  };


  const rebuildParticles = () => {
    const particleCount =
      getParticleCount();

    particles =
      Array.from(
        {
          length:
            particleCount,
        },
        () =>
          createParticle(
            true
          )
      );
  };


  const resizeCanvas = () => {
    if (
      !canvas ||
      !context
    ) {
      return;
    }

    width =
      window.innerWidth;

    height =
      window.innerHeight;

    pixelRatio =
      Math.min(
        window.devicePixelRatio ||
          1,
        2
      );

    canvas.width =
      Math.round(
        width *
        pixelRatio
      );

    canvas.height =
      Math.round(
        height *
        pixelRatio
      );

    canvas.style.width =
      `${width}px`;

    canvas.style.height =
      `${height}px`;

    context.setTransform(
      pixelRatio,
      0,
      0,
      pixelRatio,
      0,
      0
    );


    /*
     * If the pointer hasn't been used yet,
     * keep its resting position centered.
     */

    if (
      !pointer.active
    ) {
      pointer.x =
        width * 0.5;

      pointer.y =
        height * 0.5;

      pointer.targetX =
        pointer.x;

      pointer.targetY =
        pointer.y;
    }

    rebuildParticles();
  };


  const drawParticle = (
    particle: DustParticle,
    time: number
  ) => {
    if (!context) {
      return;
    }

    const flicker =
      0.82 +
      Math.sin(
        time *
          0.0018 +
        particle.flickerOffset
      ) *
        0.18;

    context.globalAlpha =
      particle.opacity *
      flicker;

    context.font =
      `${particle.size}px "Adwaita Mono", monospace`;

    context.fillStyle =
      '#ffffff';

    context.fillText(
      particle.character,
      particle.x,
      particle.y
    );
  };


  const resetParticle = (
    particle: DustParticle
  ) => {
    const replacement =
      createParticle(
        false
      );

    Object.assign(
      particle,
      replacement
    );
  };


  /*
   * PAGE-WIDE WIND
   *
   * Converts pointer position into:
   *
   * left edge  = -1
   * center     =  0
   * right edge = +1
   *
   * The cubic curve keeps the middle relatively
   * calm while allowing the wind to become more
   * apparent toward either edge.
   */

  const getGlobalWind = () => {
    if (
      !pointer.active ||
      width <= 0
    ) {
      return 0;
    }

    const normalized =
      (
        pointer.x /
        width
      ) *
        2 -
      1;

    const curved =
      normalized *
      normalized *
      normalized;

    return (
      curved *
      GLOBAL_WIND_STRENGTH
    );
  };


  /*
   * LOCAL CURSOR FIELD
   *
   * A broad pressure field gently pushes dust
   * away from the cursor.
   *
   * The quadratic falloff prevents a hard edge
   * from appearing around the interaction radius.
   */

  const getPointerForce = (
    particle: DustParticle
  ) => {
    if (
      !pointer.active
    ) {
      return {
        x: 0,
        y: 0,
      };
    }

    const deltaX =
      particle.x -
      pointer.x;

    const deltaY =
      particle.y -
      pointer.y;

    const distanceSquared =
      deltaX *
        deltaX +
      deltaY *
        deltaY;

    const radiusSquared =
      POINTER_FIELD_RADIUS *
      POINTER_FIELD_RADIUS;

    if (
      distanceSquared >=
        radiusSquared ||
      distanceSquared === 0
    ) {
      return {
        x: 0,
        y: 0,
      };
    }

    const distance =
      Math.sqrt(
        distanceSquared
      );

    const normalizedDistance =
      distance /
      POINTER_FIELD_RADIUS;

    const falloff =
      1 -
      normalizedDistance;

    const softenedFalloff =
      falloff *
      falloff;

    const force =
      POINTER_FIELD_FORCE *
      softenedFalloff;

    return {
      x:
        (
          deltaX /
          distance
        ) *
        force,

      y:
        (
          deltaY /
          distance
        ) *
        force,
    };
  };


  /*
   * Smooth the invisible wind source toward the
   * actual pointer.
   */

  const updatePointer = (
    delta: number
  ) => {
    if (
      !pointer.active
    ) {
      return;
    }

    const smoothing =
      1 -
      Math.exp(
        -POINTER_SMOOTHING *
        delta
      );

    pointer.x +=
      (
        pointer.targetX -
        pointer.x
      ) *
      smoothing;

    pointer.y +=
      (
        pointer.targetY -
        pointer.y
      ) *
      smoothing;
  };


  const renderStatic = () => {
    if (
      !context ||
      !canvas
    ) {
      return;
    }

    context.clearRect(
      0,
      0,
      width,
      height
    );

    particles.forEach(
      (particle) => {
        drawParticle(
          particle,
          0
        );
      }
    );

    context.globalAlpha = 1;
  };


  const animate = (
    time: number
  ) => {
    if (
      !context ||
      !canvas
    ) {
      return;
    }

    const delta =
      previousTime === 0
        ? 0
        : Math.min(
            (
              time -
              previousTime
            ) /
              1000,
            0.05
          );

    previousTime = time;


    /*
     * Ease the invisible wind source toward the
     * cursor before calculating forces.
     */

    updatePointer(
      delta
    );


    const globalWind =
      getGlobalWind();


    context.clearRect(
      0,
      0,
      width,
      height
    );


    particles.forEach(
      (particle) => {
        particle.drift +=
          particle.driftSpeed *
          delta;


        /*
         * Existing ambient drift.
         */

        const ambientX =
          particle.velocityX +
          Math.sin(
            particle.drift
          ) *
            5;


        /*
         * Cursor pressure field.
         */

        const pointerForce =
          getPointerForce(
            particle
          );


        particle.x +=
          (
            ambientX +
            globalWind +
            pointerForce.x
          ) *
          delta;


        particle.y +=
          (
            particle.velocityY +
            pointerForce.y
          ) *
          delta;


        /*
         * Horizontal wrapping.
         */

        if (
          particle.x <
          -20
        ) {
          particle.x =
            width +
            20;
        }

        if (
          particle.x >
          width +
            20
        ) {
          particle.x =
            -20;
        }


        /*
         * Respawn particles above the viewport
         * once they fall beyond the bottom.
         */

        if (
          particle.y >
          height +
            30
        ) {
          resetParticle(
            particle
          );
        }


        drawParticle(
          particle,
          time
        );
      }
    );


    context.globalAlpha = 1;

    animationFrame =
      requestAnimationFrame(
        animate
      );
  };


  const startVisual = () => {
    cancelAnimationFrame(
      animationFrame
    );

    previousTime = 0;

    if (
      reducedMotionQuery.matches
    ) {
      renderStatic();

      return;
    }

    animationFrame =
      requestAnimationFrame(
        animate
      );
  };


  /*
   * POINTER INPUT
   *
   * Touch isn't treated as persistent wind input.
   */

  const handlePointerMove = (
    event: PointerEvent
  ) => {
    if (
      event.pointerType ===
      'touch'
    ) {
      return;
    }

    pointer.targetX =
      event.clientX;

    pointer.targetY =
      event.clientY;

    if (
      !pointer.active
    ) {
      pointer.x =
        event.clientX;

      pointer.y =
        event.clientY;

      pointer.active = true;
    }
  };


  const handlePointerLeave = () => {
    pointer.active = false;

    pointer.x =
      width * 0.5;

    pointer.y =
      height * 0.5;

    pointer.targetX =
      pointer.x;

    pointer.targetY =
      pointer.y;
  };


  if (
    canvas &&
    context
  ) {
    resizeCanvas();
    startVisual();

    window.addEventListener(
      'resize',
      () => {
        resizeCanvas();
        startVisual();
      }
    );

    window.addEventListener(
      'pointermove',
      handlePointerMove,
      {
        passive: true,
      }
    );

    document.documentElement.addEventListener(
      'mouseleave',
      handlePointerLeave
    );

    reducedMotionQuery.addEventListener(
      'change',
      startVisual
    );
  }
</script>

<style>
  .not-found-visual {
    position: absolute;
    inset: 0;

    z-index: 0;

    display: block;

    width: 100%;
    height: 100%;

    pointer-events: none;
  }
</style>