---
import type { LinkEntry } from '../../data/links';

interface Props {
  link: LinkEntry;
}

const { link } = Astro.props;
---

<a
  class="link-card"
  href={link.href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="link-icon" aria-hidden="true">
    {link.icon && (
      <i class={`ph ph-${link.icon}`}></i>
    )}
  </span>

  <span class="link-name">
    {link.name}
  </span>

  <span class="link-type">
    {link.type}
  </span>
</a>

<style>
  .link-card {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: 1rem;

    width: 100%;

    padding: 0.75rem 0;

    border-bottom: 1px solid #111;

    color: #111;
    text-decoration: none;
  }

  .link-icon {
    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 1.4rem;
  }

  .link-name {
    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(1.5rem, 2.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1;
  }

  .link-type {
    font-family: "Adwaita Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;

    text-transform: uppercase;
  }

  .link-card:hover,
  .link-card:focus-visible {
    background: rgba(0, 0, 0, 0.06);
  }
</style>