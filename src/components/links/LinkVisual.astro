<div class="link-visual" data-link-visual aria-hidden="true"></div>

<script>
  import { textmode } from 'textmode.js';

  const container =
    document.querySelector<HTMLElement>('[data-link-visual]');

  if (container) {
    const t = textmode.create({
      width: container.clientWidth,
      height: container.clientHeight,
      fontSize: 10,
    });

    /*
     * COLOURS — LOCKED
     */

    const COLORS = {
      deep: [104, 55, 180],
      violet: [147, 86, 255],
      mauve: [203, 166, 247],
      pink: [225, 150, 255],
      lavender: [210, 190, 255],
      white: [255, 255, 255],
    } as const;

    type RGB = readonly [number, number, number];
    type Vec3 = [number, number, number];

    interface Cell {
      x: number;
      y: number;
      z: number;
      light: number;
    }

    /*
     * TORUS
     */

    const MAJOR_RADIUS = 1.25;
    const MINOR_RADIUS = 0.48;

    const MAJOR_STEPS = 220;
    const MINOR_STEPS = 110;

    /*
     * LIGHT
     *
     * Think of this as a soft light mounted
     * above the camera.
     *
     * -Y = above
     * +Z = toward camera
     */

    const LIGHT: Vec3 = [
      0,
      -0.72,
      0.69,
    ];

    /*
     * HELPERS
     */

    const clamp = (
      value: number,
      min = 0,
      max = 1,
    ) =>
      Math.max(
        min,
        Math.min(max, value),
      );

    function mix(
      a: RGB,
      b: RGB,
      amount: number,
    ): Vec3 {
      const n = clamp(amount);

      return [
        Math.round(
          a[0] +
          (b[0] - a[0]) * n,
        ),

        Math.round(
          a[1] +
          (b[1] - a[1]) * n,
        ),

        Math.round(
          a[2] +
          (b[2] - a[2]) * n,
        ),
      ];
    }

    /*
     * XYZ ROTATION
     */

    function rotate(
      [x, y, z]: Vec3,
      ax: number,
      ay: number,
      az: number,
    ): Vec3 {
      const sx = Math.sin(ax);
      const cx = Math.cos(ax);

      const sy = Math.sin(ay);
      const cy = Math.cos(ay);

      const sz = Math.sin(az);
      const cz = Math.cos(az);

      const y1 =
        y * cx -
        z * sx;

      const z1 =
        y * sx +
        z * cx;

      const x2 =
        x * cy +
        z1 * sy;

      const z2 =
        -x * sy +
        z1 * cy;

      return [
        x2 * cz -
        y1 * sz,

        x2 * sz +
        y1 * cz,

        z2,
      ];
    }

    /*
     * COLOUR
     */

    function getColor(
      light: number,
    ): Vec3 {
      if (light < 0.18) {
        return mix(
          COLORS.deep,
          COLORS.violet,
          light / 0.18,
        );
      }

      if (light < 0.45) {
        return mix(
          COLORS.violet,
          COLORS.mauve,
          (light - 0.18) / 0.27,
        );
      }

      if (light < 0.68) {
        return mix(
          COLORS.mauve,
          COLORS.pink,
          (light - 0.45) / 0.23,
        );
      }

      if (light < 0.84) {
        return mix(
          COLORS.pink,
          COLORS.lavender,
          (light - 0.68) / 0.16,
        );
      }

      return mix(
        COLORS.lavender,
        COLORS.white,
        (light - 0.84) / 0.16,
      );
    }

    /*
     * ASCII SHADING
     */

    function getCharacter(
      light: number,
      x: number,
      y: number,
    ) {
      const ramp =
        '.,:;-~=+*#%@';

      const noise =
        Math.sin(
          x * 12.9898 +
          y * 78.233,
        ) *
        43758.5453;

      const grain =
        noise -
        Math.floor(noise);

      const value =
        clamp(
          light +
          (grain - 0.5) *
            0.08,
        );

      return ramp[
        Math.floor(
          value *
          (ramp.length - 1),
        )
      ];
    }

    /*
     * DRAW
     */

    t.draw(() => {
      t.background(0);

      const time =
        t.frameCount / 60;

      /*
       * ROTATION
       */

      const ax =
        time * 0.37;

      const ay =
        time * 0.26;

      const az =
        time * 0.19;

      const scale =
        Math.min(
          t.grid.cols,
          t.grid.rows * 1.7,
        ) * 0.23;

      const cameraDistance =
        5.5;

      const cells =
        new Map<string, Cell>();

      /*
       * TORUS SURFACE
       */

      for (
        let i = 0;
        i < MAJOR_STEPS;
        i++
      ) {
        const u =
          i /
          MAJOR_STEPS *
          Math.PI *
          2;

        const cu =
          Math.cos(u);

        const su =
          Math.sin(u);

        for (
          let j = 0;
          j < MINOR_STEPS;
          j++
        ) {
          const v =
            j /
            MINOR_STEPS *
            Math.PI *
            2;

          const cv =
            Math.cos(v);

          const sv =
            Math.sin(v);

          const ring =
            MAJOR_RADIUS +
            MINOR_RADIUS * cv;

          /*
           * POSITION
           */

          const [
            px,
            py,
            pz,
          ] =
            rotate(
              [
                ring * cu,
                MINOR_RADIUS * sv,
                ring * su,
              ],
              ax,
              ay,
              az,
            );

          /*
           * NORMAL
           */

          const [
            nx,
            ny,
            nz,
          ] =
            rotate(
              [
                cv * cu,
                sv,
                cv * su,
              ],
              ax,
              ay,
              az,
            );

          /*
           * BACK-FACE CULLING
           */

          if (nz <= 0) {
            continue;
          }

          /*
           * PERSPECTIVE
           */

          const perspective =
            cameraDistance /
            (
              cameraDistance -
              pz
            );

          const screenX =
            Math.round(
              px *
              perspective *
              scale,
            );

          const screenY =
            Math.round(
              py *
              perspective *
              scale,
            );

          /*
           * CAMERA-BIASED OVERHEAD LIGHT
           *
           * Unlike the previous revision,
           * there is no fake self-shadow.
           *
           * The light lives above and near
           * the viewer, so visible surfaces
           * remain readable while the lower
           * surfaces still fall into purple.
           */

          const diffuse =
            Math.max(
              0,
              nx * LIGHT[0] +
              ny * LIGHT[1] +
              nz * LIGHT[2],
            );

          /*
           * Broad, strong light.
           */

          const broadLight =
            Math.pow(
              diffuse,
              0.72,
            );

          /*
           * Smaller bright core.
           */

          const highlight =
            Math.pow(
              diffuse,
              5,
            );

          /*
           * Front-facing surfaces receive
           * a tiny amount of fill light.
           *
           * This prevents large visible
           * areas from becoming uniformly
           * dark purple without creating
           * another bright underside patch.
           */

          const cameraFill =
            Math.pow(
              clamp(nz),
              1.5,
            );

          const light =
            clamp(
              0.09 +
              broadLight * 0.73 +
              highlight * 0.22 +
              cameraFill * 0.12,
            );

          /*
           * Z BUFFER
           */

          const key =
            `${screenX},${screenY}`;

          const existing =
            cells.get(key);

          if (
            existing &&
            existing.z >= pz
          ) {
            continue;
          }

          cells.set(
            key,
            {
              x: screenX,
              y: screenY,
              z: pz,
              light,
            },
          );
        }
      }

      /*
       * DRAW
       */

      for (
        const cell
        of cells.values()
      ) {
        const [
          r,
          g,
          b,
        ] =
          getColor(
            cell.light,
          );

        t.push();

        t.translate(
          cell.x,
          cell.y,
        );

        t.char(
          getCharacter(
            cell.light,
            cell.x,
            cell.y,
          ),
        );

        t.charColor(
          r,
          g,
          b,
        );

        t.cellColor(
          0,
          0,
          0,
        );

        t.point();

        t.pop();
      }
    });

    /*
     * CANVAS
     */

    container.appendChild(
      t.canvas,
    );

    /*
     * RESIZE
     */

    const resizeObserver =
      new ResizeObserver(
        ([entry]) => {
          if (!entry) return;

          t.resizeCanvas(
            Math.max(
              1,
              Math.floor(
                entry.contentRect.width,
              ),
            ),

            Math.max(
              1,
              Math.floor(
                entry.contentRect.height,
              ),
            ),
          );
        },
      );

    resizeObserver.observe(
      container,
    );
  }
</script>

<style>
  .link-visual {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #000;
  }

  .link-visual :global(canvas) {
    display: block;

    width: 100%;
    height: 100%;
  }
</style>