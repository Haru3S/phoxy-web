---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  {project.image && (
    <img src={project.image} alt="" />
  )}

  <h3>{project.title}</h3>

  <p>{project.description}</p>

  {project.tags && (
    <ul>
      {project.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  )}

  {project.href && (
    <a href={project.href}>View project</a>
  )}
</article>