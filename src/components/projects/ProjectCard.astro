---
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const projectNumber = String(index + 1).padStart(2, '0');
const category = project.tags?.join(' / ') ?? '';
---

<article class="project-row">
  <div class="project-number">
    {projectNumber}
  </div>

  <div class="project-name">
    <h3>
      <span>{project.title}</span>
    </h3>
  </div>

  <div class="project-category">
    {category}
  </div>

  <div class="project-action">
    {project.href ? (
      <a
        href={project.href}
        aria-label={`Open ${project.title}`}
      >
        <i class="ph ph-arrow-square-out" aria-hidden="true"></i>
      </a>
    ) : (
      <span class="disabled-link" aria-hidden="true">
        <i class="ph ph-arrow-square-out"></i>
      </span>
    )}
  </div>
</article>

<style>
  .project-row {
    display: flex;
    align-items: center;

    width: 100%;
    min-height: 72px;

    padding: 0 1.5rem;

    border-top: 1px solid var(--color-border);
  }

  .project-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /*
   * NUMBER
   */

  .project-number {
    flex: 0 0 8%;

    font-family: "Adwaita Mono", monospace;
    font-size: 0.9rem;
    font-weight: 700;
  }

  /*
   * PROJECT NAME
   */

  .project-name {
    flex: 0 0 42%;
  }

  .project-name h3 {
    margin: 0;

    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(1.25rem, 1.8vw, 2rem);
    font-weight: 700;
    line-height: 1;
  }

  .project-name h3 span {
    position: relative;

    display: inline-block;
  }

  /*
   * Animated underline
   */

  .project-name h3 span::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.08em;

    width: 100%;
    height: 0.06em;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition: transform 0.1s ease-out;
  }

  .project-row:hover .project-name h3 span::after,
  .project-row:focus-within .project-name h3 span::after {
    transform: scaleX(1);
  }

  /*
   * CATEGORY
   */

  .project-category {
    flex: 1;

    font-family: "Adwaita Mono", monospace;
    font-size: 0.9rem;
    font-weight: 700;

    text-transform: uppercase;
  }

  /*
   * ACTION
   */

  .project-action {
    flex: 0 0 3rem;

    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .project-action a,
  .disabled-link {
    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--color-fg);

    font-size: 1.5rem;

    text-decoration: none;
  }

  .disabled-link {
    opacity: 0.25;
  }

  .project-action a:hover,
  .project-action a:focus-visible {
    opacity: 0.5;
  }

  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    .project-name h3 span::after {
      transition: none;
    }
  }

  /*
   * MOBILE
   */

  @media (max-width: 700px) {
    .project-row {
      min-height: 64px;

      padding: 0 1rem;
    }

    .project-number {
      flex-basis: 3rem;
    }

    .project-name {
      flex: 1;
    }

    .project-category {
      display: none;
    }

    .project-action {
      flex-basis: 2.5rem;
    }
  }
</style>