---
import ProjectCard from './ProjectCard.astro';

import { projects } from '../../data/projects';
---

<section
  id="projects"
  class="projects-section"
>
  <h2>
    <span
      class="lens-text lens-interactive scroll-emphasis"
      data-text="Projects"
      data-scroll-emphasis
    >
      Projects
    </span>
  </h2>

  <div class="projects">
    {projects.map((project, index) => (
      <ProjectCard
        project={project}
        index={index}
      />
    ))}
  </div>
</section>

<style>
  .projects-section {
    width: 100%;

    padding-top:
      clamp(
        4rem,
        10vw,
        10rem
      );
  }

  .projects-section > h2 {
    margin: 0;

    padding:
      0
      1.5rem
      0.2em;

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        4rem,
        10vw,
        10rem
      );

    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
</style>