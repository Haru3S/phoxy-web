<section
  class="interest-textmode codec-visual"
  aria-label="Codec communication display between Big Boss and Phoxy"
>
  <div class="codec-screen">
    <!--
      LEFT / RECEIVING SIDE

      Big Boss remains a placeholder until
      Phoxy's portrait language is finalized.
    -->
    <section
      class="codec-party codec-party-left"
      aria-label="Big Boss"
    >
      <div
        class="codec-portrait"
        data-codec-portrait="big-boss"
      >
        <div
          class="codec-portrait-field"
          aria-hidden="true"
        >
          <pre class="codec-portrait-placeholder">░▒▓
BIG BOSS
▓▒░</pre>
        </div>
      </div>

      <span class="codec-party-name">
        BIG BOSS
      </span>
    </section>

    <!--
      CENTER COMMUNICATION CHANNEL
    -->
    <section
      class="codec-channel"
      aria-label="Codec frequency"
    >
      <div
        class="codec-channel-line"
        aria-hidden="true"
      ></div>

      <div class="codec-frequency-panel">
        <span class="codec-frequency">
          140.85
        </span>

        <div
          class="codec-tune-meter"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <span class="codec-tune-label">
          TUNE
        </span>
      </div>

      <div
        class="codec-channel-line"
        aria-hidden="true"
      ></div>
    </section>

    <!--
      RIGHT / PLAYER SIDE

      Phoxy is rendered as deliberately coarse
      MGS1-style character-density textmode.
    -->
    <section
      class="codec-party codec-party-right"
      aria-label="Phoxy"
    >
      <div
        class="codec-portrait"
        data-codec-portrait="phoxy"
      >
        <div
          class="codec-portrait-field codec-phoxy-field"
          aria-hidden="true"
        >
          <pre class="codec-portrait-art codec-phoxy-art">
                 ░
              ░▒▓▓▒░
            ░▓██████▓░
           ▒██████████▒
          ▓████████████▓
         ▓████▓▒▒▓██████▓
        ▓███▒░    ░▒█████▓
       ▒██▓░         ▒████▒
       ██▓            ░▓███
      ▓██░     ░░       ▓██▓
      ██▒    ░▒▓▓▒░      ███
     ▒██░   ▒██████▒     ▒██▒
     ▓██   ░██▓▒▒▓██░     ██▓
     ██▓   ▓█▒    ▒█▓     ▓██
     ██▒  ░█▓      ▓█░    ▒██
     ██░  ▒█░ ░  ░ ░█▒    ░██
     ██   ▓▓ ▒▓  ▓▒ ▓▓     ██
     ██   █▒ ▓█  █▓ ▒█     ██
     ██   █░ ▒▓  ▓▒ ░█     ██
     ██   ▓▒    ░    ▒▓     ██
     ▓█▒  ▒▓   ░░░   ▓▒    ▒█▓
     ▒██░ ░█▒   ▒   ▒█░   ░██▒
      ██▓  ▓█░ ░▓░ ░█▓    ▓██
      ▒██▒ ▒██▒░░░▒██▒   ▒██▒
       ███░ ▓████████▓   ░███
       ▓██▓░ ▒▓████▓▒   ░▓██▓
        ███▓░  ░▒▒░    ░▓███
        ▒████▒░      ░▒████▒
         ▓██████▓▒▒▓██████▓
          ▒██████████████▒
           ░▓██████████▓░
             ▒▓████▓▒
              ░▓██▓░
               ▒██▒
              ░████░
             ▒██████▒
           ░▓████████▓░
         ░▓████████████▓░
        ▒████████████████▒
       ▓██████████████████▓
      ▓████████████████████▓
     ▒██████████████████████▒</pre>
        </div>
      </div>

      <span class="codec-party-name">
        PHOXY
      </span>
    </section>

    <!--
      LOWER CODEC CONTROLS
    -->
    <div class="codec-controls">
      <button
        class="codec-control codec-control-ptt"
        type="button"
        aria-disabled="true"
        tabindex="-1"
      >
        <span class="codec-control-label">
          PTT
        </span>

        <span
          class="codec-control-switch"
          aria-hidden="true"
        >
          <span></span>
        </span>
      </button>

      <div
        class="codec-control-spacer"
        aria-hidden="true"
      ></div>

      <button
        class="codec-control codec-control-memory"
        type="button"
        aria-disabled="true"
        tabindex="-1"
      >
        <span
          class="codec-control-switch"
          aria-hidden="true"
        >
          <span></span>
        </span>

        <span class="codec-control-label">
          MEMORY
        </span>
      </button>
    </div>

    <!-- Display metadata -->
    <div
      class="codec-display-meta"
      aria-hidden="true"
    >
      <span>PTT</span>

      <span>
        CODEC / 140.85
      </span>

      <span>MEMORY</span>
    </div>
  </div>
</section>