---
const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const snakePortrait =
  `${base}assets/interests/codecSnake.webp`;

const phoxyPortrait =
  `${base}assets/interests/codecPhoxy.webp`;
---

<section
  class="interest-textmode codec-visual"
  aria-label="Codec communication display between Solid Snake and Phoxy"
>
  <div class="codec-screen">
    <!-- Solid Snake / receiving side -->
    <section
      class="codec-party codec-party-left"
      aria-label="Solid Snake"
    >
      <div
        class="codec-portrait"
        data-codec-portrait="snake"
      >
        <div class="codec-portrait-field">
          <img
            class="codec-portrait-image"
            src={snakePortrait}
            alt=""
            width="52"
            height="89"
            draggable="false"
          />
        </div>
      </div>

      <span class="codec-party-name">
        SOLID SNAKE
      </span>
    </section>

    <!-- Codec frequency -->
    <section
      class="codec-channel"
      aria-label="Codec frequency"
    >
      <div
        class="codec-channel-line"
        aria-hidden="true"
      ></div>

      <div class="codec-frequency-panel">
        <span class="codec-frequency">
          140.85
        </span>

        <div
          class="codec-tune-meter"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <span class="codec-tune-label">
          TUNE
        </span>
      </div>

      <div
        class="codec-channel-line"
        aria-hidden="true"
      ></div>
    </section>

    <!-- Phoxy / player side -->
    <section
      class="codec-party codec-party-right"
      aria-label="Phoxy"
    >
      <div
        class="codec-portrait"
        data-codec-portrait="phoxy"
      >
        <div class="codec-portrait-field">
          <img
            class="codec-portrait-image"
            src={phoxyPortrait}
            alt=""
            width="52"
            height="89"
            draggable="false"
          />
        </div>
      </div>

      <span class="codec-party-name">
        PHOXY
      </span>
    </section>

    <!-- Codec controls -->
    <div class="codec-controls">
      <button
        class="codec-control codec-control-ptt"
        type="button"
        aria-disabled="true"
        tabindex="-1"
      >
        <span class="codec-control-label">
          PTT
        </span>

        <span
          class="codec-control-switch"
          aria-hidden="true"
        >
          <span></span>
        </span>
      </button>

      <div
        class="codec-control-spacer"
        aria-hidden="true"
      ></div>

      <button
        class="codec-control codec-control-memory"
        type="button"
        aria-disabled="true"
        tabindex="-1"
      >
        <span
          class="codec-control-switch"
          aria-hidden="true"
        >
          <span></span>
        </span>

        <span class="codec-control-label">
          MEMORY
        </span>
      </button>
    </div>

    <!-- Display metadata -->
    <div
      class="codec-display-meta"
      aria-hidden="true"
    >
      <span>PTT</span>

      <span>
        CODEC / 140.85
      </span>

      <span>MEMORY</span>
    </div>
  </div>
</section>