<section
  class="interest-textmode codec-visual"
  aria-label="Codec visual"
>
  <div class="codec-placeholder">
    <!-- Receiving end -->
    <div class="codec-placeholder-side">
      <span class="codec-placeholder-label">
        BIG BOSS
      </span>

      <span class="codec-placeholder-box">
        PORTRAIT
      </span>
    </div>

    <!-- Codec frequency -->
    <div class="codec-placeholder-center">
      <span class="codec-frequency">
        140.85
      </span>

      <span
        class="codec-placeholder-frequency"
        aria-hidden="true"
      >
        ━━━━━━━━━━━━━
      </span>

      <span class="codec-call-state">
        CALLING
      </span>

      <div
        class="codec-controls"
        aria-label="Codec controls"
      >
        <button
          class="codec-control"
          type="button"
          aria-disabled="true"
          tabindex="-1"
        >
          <span class="codec-control-key">
            PTT
          </span>

          <span class="codec-control-label">
            PUSH TO TALK
          </span>
        </button>

        <button
          class="codec-control"
          type="button"
          aria-disabled="true"
          tabindex="-1"
        >
          <span class="codec-control-key">
            MEMORY
          </span>

          <span class="codec-control-label">
            SELECT
          </span>
        </button>
      </div>
    </div>

    <!-- Player side -->
    <div class="codec-placeholder-side">
      <span class="codec-placeholder-label">
        PHOXY
      </span>

      <span class="codec-placeholder-box">
        PORTRAIT
      </span>
    </div>
  </div>
</section>