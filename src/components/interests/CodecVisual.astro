---
import {
  codecLines,
} from '../../data/codec';

const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;

const campbellPortrait =
  `${base}assets/interests/codec/codecCampbell.webp`;

const phoxyPortrait =
  `${base}assets/interests/codec/codecPhoxy.webp`;

const firstLine =
  codecLines[0];
---

<section
  class="interest-textmode codec-visual"
  aria-label="Codec communication display between Colonel Campbell and Phoxy"
>
  <div
    class="codec-screen"
    data-codec
  >
    <!--
      TOP HARDWARE

      These controls visually recreate the
      Codec hardware but are intentionally
      unavailable.

      Attempting to activate one uses the
      site's global denied-input feedback.
    -->
    <div class="codec-hardware">
      <!-- PTT -->
      <div
        class="codec-hardware-control codec-hardware-ptt"
        role="button"
        aria-disabled="true"
        tabindex="0"
        aria-label="PTT unavailable"
      >
        <span class="codec-hardware-label">
          PTT
        </span>

        <span
          class="codec-hardware-button"
          aria-hidden="true"
        >
          <span></span>
        </span>
      </div>

      <!-- TUNER -->
      <div
        class="codec-tuner"
        role="button"
        aria-disabled="true"
        tabindex="0"
        aria-label="Codec tuning unavailable"
      >
        <div
          class="codec-tuner-header"
          aria-hidden="true"
        >
          <span class="codec-tuner-label">
            TUNE
          </span>

          <span class="codec-frequency">
            140.85
          </span>
        </div>

        <div
          class="codec-visualizer"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div
          class="codec-tuner-scale"
          aria-hidden="true"
        >
          <span>140</span>
          <span>142</span>
          <span>145</span>
        </div>
      </div>

      <!-- MEMORY -->
      <div
        class="codec-hardware-control codec-hardware-memory"
        role="button"
        aria-disabled="true"
        tabindex="0"
        aria-label="Memory unavailable"
      >
        <span class="codec-hardware-label">
          MEM
        </span>

        <span
          class="codec-hardware-button"
          aria-hidden="true"
        >
          <span></span>
        </span>
      </div>
    </div>

    <!--
      COLONEL CAMPBELL
    -->
    <section
      class="codec-party codec-party-left"
      aria-label="Colonel Campbell"
    >
      <div class="codec-portrait">
        <img
          class="codec-portrait-image"
          src={campbellPortrait}
          alt=""
          width="52"
          height="89"
          draggable="false"
        />
      </div>

      <span class="codec-party-name">
        COLONEL CAMPBELL
      </span>
    </section>

    <!--
      PHOXY
    -->
    <section
      class="codec-party codec-party-right"
      aria-label="Phoxy"
    >
      <div class="codec-portrait">
        <img
          class="codec-portrait-image"
          src={phoxyPortrait}
          alt=""
          width="52"
          height="89"
          draggable="false"
        />
      </div>

      <span class="codec-party-name">
        PHOXY
      </span>
    </section>

    <!--
      DIALOGUE
    -->
    <section
      class="codec-dialogue"
      aria-live="polite"
    >
      <span
        class="codec-dialogue-speaker"
        data-codec-speaker
      >
        {firstLine.speaker}
      </span>

      <p
        class="codec-dialogue-text"
        data-codec-dialogue
      >
        {firstLine.text}
      </p>
    </section>

    <!--
      DECORATIVE LOWER READOUT
    -->
    <div
      class="codec-lower-readout"
      aria-hidden="true"
    >
      <span>
        CALL
      </span>

      <span class="codec-lower-dot"></span>

      <span>
        140.85
      </span>

      <span class="codec-lower-dot"></span>

      <span>
        MEMORY
      </span>
    </div>

    <!--
      BUILD-TIME DIALOGUE DATA
    -->
    <script
      type="application/json"
      data-codec-lines
      set:html={JSON.stringify(codecLines)}
    ></script>
  </div>
</section>

<script>
  import '../../scripts/codec.ts';
</script>