---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

interface Props {
  first: NavItem;
  second: NavItem;
}

const { first, second } = Astro.props;
---

<nav class="page-nav" aria-label="Page navigation">
  <a href={first.href}>
    <span class="nav-label">
      {first.label}
    </span>

    <span class="nav-icon" aria-hidden="true">
      <i class={`ph ph-${first.icon}`}></i>
    </span>
  </a>

  <a href={second.href}>
    <span class="nav-label">
      {second.label}
    </span>

    <span class="nav-icon" aria-hidden="true">
      <i class={`ph ph-${second.icon}`}></i>
    </span>
  </a>
</nav>

<style>
  .page-nav {
    position: sticky;
    bottom: 0;

    display: flex;
    flex-direction: column;

    width: 100%;

    margin-top: auto;

    background: var(--color-bg);

    border-top: 1px solid var(--color-border);
  }

  .page-nav a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;

    width: 100%;

    padding: 0.35em 0.5em;

    color: var(--color-fg);

    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(2.5rem, 4vw, 4.5rem);
    font-weight: 500;
    line-height: 1;

    text-decoration: none;
  }

  .page-nav a + a {
    border-top: 1px solid var(--color-border);
  }

  /*
   * LABEL
   */

  .nav-label {
    position: relative;

    grid-column: 1;
    grid-row: 1;

    width: fit-content;
  }

  /*
   * Animated underline
   */

  .nav-label::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.08em;

    width: 100%;
    height: 0.06em;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition: transform 0.1s ease-out;
  }

  .page-nav a:hover .nav-label::after,
  .page-nav a:focus-visible .nav-label::after {
    transform: scaleX(1);
  }

  /*
   * ICON
   */

  .nav-icon {
    grid-column: 2;
    grid-row: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    padding-right: 0.15em;
  }

  .nav-icon i {
    font-size: 0.65em;
  }

  /*
   * ROW HOVER
   */

  .page-nav a:hover,
  .page-nav a:focus-visible {
    background: var(--color-hover);
  }

  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    .nav-label::after {
      transition: none;
    }
  }
</style>