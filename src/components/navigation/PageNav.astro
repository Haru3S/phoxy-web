---
interface NavItem {
  label: string;
  href: string;
  icon: string;
}

interface Props {
  first: NavItem;
  second: NavItem;
}

const { first, second } = Astro.props;
---

<nav class="page-nav" aria-label="Page navigation">
  <a href={first.href}>
    <span class="nav-label">{first.label}</span>

    <span class="nav-icon" aria-hidden="true">
      <i class={`ph ph-${first.icon}`}></i>
    </span>
  </a>

  <a href={second.href}>
    <span class="nav-label">{second.label}</span>

    <span class="nav-icon" aria-hidden="true">
      <i class={`ph ph-${second.icon}`}></i>
    </span>
  </a>
</nav>

<style>
  .page-nav {
    position: sticky;
    bottom: 0;

    display: flex;
    flex-direction: column;

    width: 100%;
    margin-top: auto;

    background: #fff;

    border-top: 1px solid #111;
  }

  .page-nav a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;

    width: 100%;

    padding: 0.35em 0.5em;

    color: #111;

    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(2.5rem, 4vw, 4.5rem);
    font-weight: 500;
    line-height: 1;

    text-decoration: none;
  }

  .page-nav a + a {
    border-top: 1px solid #111;
  }

  .nav-label {
    grid-column: 1;
    grid-row: 1;
  }

  .nav-icon {
    grid-column: 2;
    grid-row: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    padding-right: 0.15em;
  }

  .nav-icon i {
    font-size: 0.65em;
  }

  .page-nav a:hover,
  .page-nav a:focus-visible {
    background: rgba(0, 0, 0, 0.06);
  }
</style>