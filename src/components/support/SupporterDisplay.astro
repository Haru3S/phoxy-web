  }

  .supporters-header > span {
    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .supporter-tabs {
    display: flex;
    align-items: center;

    gap: 1rem;
  }

  .supporter-tab {
    position: relative;

    padding: 0;

    border: 0;

    background: transparent;
    color: var(--color-fg);

    font-family:
      "Adwaita Mono",
