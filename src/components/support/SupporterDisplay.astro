---
import type {
  SupporterRecord,
} from '../../data/support/supporterTypes';

import {
  canAppearInAmount,
  canAppearInRecent,
  canAppearInTotal,
  getPublicDisplayName,
} from '../../lib/support/supporterPrivacy';

import '../../styles/support/supporterDisplay.css';

/*
 * TEMPORARY DEVELOPMENT DATA
 *
 * This is deliberately shaped like the eventual
 * normalized backend response.
 *
 * Stripe and crypto will both become producers of
 * this same record format.
 *
 * Delete these records once the supporter API is
 * connected.
 */

const supporterRecords: SupporterRecord[] = [
  {
    id: 'mock-stripe-001',
    displayName: 'PhoxyFan',
    anonymous: false,
    amountUsd: 20,
    source: 'stripe',
    asset: 'usd',
    nativeAmount: '20.00',
    supportedAt: '2026-10-04T20:15:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
  {
    id: 'mock-ltc-001',
    displayName: 'Kalli',
    anonymous: false,
    amountUsd: 12.48,
    source: 'crypto',
    asset: 'ltc',
    nativeAmount: '0.127',
    supportedAt: '2026-10-03T17:42:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
  {
    id: 'mock-stripe-002',
    displayName: null,
    anonymous: true,
    amountUsd: 10,
    source: 'stripe',
    asset: 'usd',
    nativeAmount: '10.00',
    supportedAt: '2026-10-02T22:08:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
  {
    id: 'mock-btc-001',
    displayName: 'FoxFriend',
    anonymous: false,
    amountUsd: 32.16,
    source: 'crypto',
    asset: 'btc',
    nativeAmount: '0.0003',
    supportedAt: '2026-10-01T19:30:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
  {
    id: 'mock-stripe-003',
    displayName: 'PhoxyFan',
    anonymous: false,
    amountUsd: 5,
    source: 'stripe',
    asset: 'usd',
    nativeAmount: '5.00',
    supportedAt: '2026-09-30T16:10:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
  {
    id: 'mock-sol-001',
    displayName: null,
    anonymous: true,
    amountUsd: 8.72,
    source: 'crypto',
    asset: 'sol',
    nativeAmount: '0.04',
    supportedAt: '2026-09-29T21:25:00.000Z',
    verified: true,
    moderationStatus: 'approved',
    moderationReason: null,
  },
];

const recentRecords =
  supporterRecords
    .filter(canAppearInRecent)
    .sort(
      (a, b) =>
        new Date(b.supportedAt).getTime() -
        new Date(a.supportedAt).getTime()
    );

const amountRecords =
  supporterRecords
    .filter(canAppearInAmount)
    .sort(
      (a, b) =>
        b.amountUsd - a.amountUsd
    );

const totalsMap =
  new Map<
    string,
    {
      key: string;
      displayName: string;
      totalUsd: number;
      contributionCount: number;
      latestSupportAt: string;
    }
  >();

for (
  const record of supporterRecords.filter(
    canAppearInTotal
  )
) {
  const displayName =
    getPublicDisplayName(record);

  const key =
    displayName.toLowerCase();

  const existing =
    totalsMap.get(key);

  if (!existing) {
    totalsMap.set(
      key,
      {
        key,
        displayName,
        totalUsd:
          record.amountUsd,
        contributionCount: 1,
        latestSupportAt:
          record.supportedAt,
      }
    );

    continue;
  }

  existing.totalUsd +=
    record.amountUsd;

  existing.contributionCount += 1;

  if (
    new Date(
      record.supportedAt
    ).getTime() >
    new Date(
      existing.latestSupportAt
    ).getTime()
  ) {
    existing.latestSupportAt =
      record.supportedAt;
  }
}

const totalRecords =
  Array.from(
    totalsMap.values()
  ).sort(
    (a, b) =>
      b.totalUsd - a.totalUsd
  );

function formatUsd(
  amount: number
): string {
  return new Intl.NumberFormat(
    'en-US',
    {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }
  ).format(amount);
}

function formatDate(
  value: string
): string {
  return new Intl.DateTimeFormat(
    'en-US',
    {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }
  ).format(
    new Date(value)
  );
}

function getSourceLabel(
  record: SupporterRecord
): string {
  if (
    record.source === 'stripe'
  ) {
    return 'FIAT';
  }

  if (
    record.source === 'crypto' &&
    record.asset
  ) {
    return record.asset.toUpperCase();
  }

  return record.source.toUpperCase();
}
---

<section
  class="supporters"
  data-supporter-display
>
  <header class="supporters-header">
    <span>SUPPORTERS</span>

    <nav
      class="supporter-tabs"
      aria-label="Supporter views"
    >
      <button
        type="button"
        class="supporter-tab is-active"
        data-support-tab="recent"
        aria-pressed="true"
      >
        Recent
      </button>

      <button
        type="button"
        class="supporter-tab"
        data-support-tab="total"
        aria-pressed="false"
      >
        Total
      </button>

      <button
        type="button"
        class="supporter-tab"
        data-support-tab="amount"
        aria-pressed="false"
      >
        Amount
      </button>
    </nav>
  </header>

  <div class="supporter-display">
    <section
      class="supporter-view"
      data-support-view="recent"
    >
      {
        recentRecords.length > 0 ? (
          <ol class="supporter-list">
            {
              recentRecords.map(
                (record) => (
                  <li class="supporter-entry">
                    <div class="supporter-entry-main">
                      <strong>
                        {getPublicDisplayName(record)}
                      </strong>

                      <span>
                        {formatUsd(record.amountUsd)}
                      </span>
                    </div>

                    <div class="supporter-entry-meta">
                      <span>
                        {getSourceLabel(record)}
                      </span>

                      <time
                        datetime={record.supportedAt}
                        data-relative-time
                      >
                        {formatDate(record.supportedAt)}
                      </time>
                    </div>
                  </li>
                )
              )
            }
          </ol>
        ) : (
          <div class="supporter-empty">
            <span class="view-status">
              NO VERIFIED SUPPORT YET
            </span>

            <h2>
              First one's still up for grabs.
            </h2>

            <p>
              Verified support will appear here
              once a payment source records it.
            </p>
          </div>
        )
      }
    </section>

    <section
      class="supporter-view"
      data-support-view="total"
      hidden
    >
      {
        totalRecords.length > 0 ? (
          <ol class="supporter-list">
            {
              totalRecords.map(
                (supporter) => (
                  <li class="supporter-entry">
                    <div class="supporter-entry-main">
                      <strong>
                        {supporter.displayName}
                      </strong>

                      <span>
                        {formatUsd(supporter.totalUsd)}
                      </span>
                    </div>

                    <div class="supporter-entry-meta">
                      <span>
                        {
                          supporter.contributionCount === 1
                            ? '1 SUPPORT'
                            : `${supporter.contributionCount} SUPPORTS`
                        }
                      </span>

                      <span>
                        LAST {formatDate(
                          supporter.latestSupportAt
                        )}
                      </span>
                    </div>
                  </li>
                )
              )
            }
          </ol>
        ) : (
          <div class="supporter-empty">
            <span class="view-status">
              NO PUBLIC TOTALS YET
            </span>

            <h2>
              Supporter totals will live here.
            </h2>

            <p>
              Repeat support using the same public
              display name will be combined here.
            </p>
          </div>
        )
      }
    </section>

    <section
      class="supporter-view"
      data-support-view="amount"
      hidden
    >
      {
        amountRecords.length > 0 ? (
          <ol class="supporter-list">
            {
              amountRecords.map(
                (record) => (
                  <li class="supporter-entry">
                    <div class="supporter-entry-main">
                      <strong>
                        {getPublicDisplayName(record)}
                      </strong>

                      <span>
                        {formatUsd(record.amountUsd)}
                      </span>
                    </div>

                    <div class="supporter-entry-meta">
                      <span>
                        {getSourceLabel(record)}
                      </span>

                      <span>
                        {formatDate(record.supportedAt)}
                      </span>
                    </div>
                  </li>
                )
              )
            }
          </ol>
        ) : (
          <div class="supporter-empty">
            <span class="view-status">
              NO PUBLIC AMOUNTS YET
            </span>

            <h2>
              Support amounts will appear here.
            </h2>

            <p>
              Named verified support is included
              in amount rankings.
            </p>
          </div>
        )
      }
    </section>
  </div>

  <footer
    class="supporters-footer"
    aria-hidden="true"
  ></footer>
</section>

<script>
  import '../../scripts/supporterDisplay.ts';
</script>