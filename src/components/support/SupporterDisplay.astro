    font-family:
      "Inter Variable",
      sans-serif;

    font-size:
      clamp(
        0.9rem,
        1.1vw,
        1.1rem
      );

    line-height: 1.25;
  }

  .view-note {
    opacity: 0.7;
  }

  @media (
