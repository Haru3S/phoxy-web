    font-size: 0.7rem;
    font-weight: 700;

    cursor: pointer;
  }

  .supporter-tab::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.2rem;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition:
