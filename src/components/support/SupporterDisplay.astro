    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        1.8rem,
        3vw,
        3.4rem
      );

    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  p {
    max-width: 42ch;

    margin:
      0
