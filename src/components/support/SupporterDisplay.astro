  }

  .supporter-tab:hover::after,
  .supporter-tab:focus-visible::after,
  .supporter-tab.is-active::after {
    transform: scaleX(1);
  }

  .supporter-display {
    flex: 1 1 0;

    display: flex;
    align-items: center;

    width: 100%;

    min-width: 0;
    min-height: 0;

    overflow-y: auto;
    overflow-x: hidden;

    scrollbar-width: thin;
  }

  .supporter-view {
    width: 100%;
    max-width: 42rem;

    padding:
      clamp(
        1.25rem,
        2.5vw,
        2.5rem
      )
      0.75rem;
  }

  .supporter-view[hidden] {
    display: none;
  }

  .view-status,
  .view-note {
    display: block;

    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.65rem;
    font-weight: 700;

    letter-spacing: 0.03em;
  }

  .view-status {
    margin-bottom: 0.75rem;

    opacity: 0.5;
  }

  h2 {
