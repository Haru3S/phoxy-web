---
import Admonition from '../ui/Admonition.astro';
import { CRYPTO_ASSETS, type CryptoAsset } from '../../lib/support/cryptoAssets';
import '../../styles/support/fiatSupport.css';
import '../../styles/support/cryptoSupport.css';

const names: Record<CryptoAsset, string> = {
  ltc: 'Litecoin', btc: 'Bitcoin', eth: 'Ethereum', sol: 'Solana',
  doge: 'Dogecoin', usdc: 'USD Coin', usdt: 'Tether',
};
// Render public metadata from the backend map; no provider identifiers are
// needed by the browser controller.
const currencies = Object.entries(CRYPTO_ASSETS).map(([asset, config]) => ({
  asset, name: names[asset as CryptoAsset], symbol: asset.toUpperCase(), network: config.network,
}));
---

<section class="support-view fiat-support crypto-support" data-support-page="crypto" data-crypto-support aria-hidden="true">
  <header class="detail-toolbar">
    <button class="back-button" type="button" data-support-back>
      <i class="ph ph-arrow-left" aria-hidden="true"></i><span>Back</span>
    </button>
    <span>CRYPTO / NOWPAYMENTS</span>
  </header>
  <div class="detail-heading">
    <h1><span class="lens-text lens-interactive" data-text="Crypto">Crypto</span></h1>
    <p>Support me with crypto. Choose your amount and currency, then send your payment through NOWPayments.</p>
  </div>

  <section class="fiat-content">
    <div class="fiat-step" data-crypto-step="identity" aria-hidden="false">
      <div class="fiat-step-heading">
        <span class="fiat-step-index">01 / 04</span>
        <h2 tabindex="-1">Whatcha' Be Called</h2>
        <p>Choose the name that'll represent you on the supporter leaderboard.</p>
      </div>
      <div class="fiat-identity">
        <Admonition type="note">
          <p>I don't use accounts or track personal data to identify returning supporters. Support using the same display name is combined on the leaderboard.</p>
        </Admonition>
        <label class="fiat-field" for="crypto-display-name">
          <span>DISPLAY NAME</span>
          <input id="crypto-display-name" type="text" minlength="2" maxlength="24" autocomplete="off" spellcheck="false"
            placeholder="Anonymous" aria-describedby="crypto-name-help crypto-name-error" data-crypto-display-name />
        </label>
        <span class="fiat-field-help" id="crypto-name-help">2–24 characters. Letters, numbers, and underscores only. This name is public. Use Skip to stay anonymous.</span>
        <span class="fiat-field-error" id="crypto-name-error" data-crypto-name-error aria-live="polite" hidden></span>
        <div class="fiat-actions">
          <button class="fiat-skip-action" type="button" data-crypto-anonymous>SKIP / STAY ANONYMOUS</button>
          <button class="fiat-primary-action" type="button" data-crypto-identity-continue>
            <span>CONTINUE</span><i class="ph ph-arrow-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="fiat-step" data-crypto-step="amount" aria-hidden="true" hidden>
      <div class="fiat-step-heading">
        <span class="fiat-step-index">02 / 04</span>
        <h2 tabindex="-1">Choose An Amount</h2>
        <p class="fiat-supporting-as">Supporting as <strong data-crypto-supporter-name>Anonymous</strong></p>
      </div>
      <div class="fiat-amount">
        <button class="fiat-amount-back" type="button" data-crypto-edit="identity">
          <i class="ph ph-arrow-left" aria-hidden="true"></i><span>CHANGE DISPLAY NAME</span>
        </button>
        <div class="fiat-amount-options" role="group" aria-label="Choose support amount">
          {[5, 10, 20, 50].map(amount => (
            <button class="fiat-amount-option" type="button" data-crypto-amount={amount} aria-pressed="false"><span>${amount}</span><small>USD</small></button>
          ))}
        </div>
        <div class="fiat-custom-amount" data-crypto-custom-container>
          <label class="fiat-field" for="crypto-custom-amount">
            <span>CUSTOM AMOUNT</span>
            <div class="fiat-money-input">
              <span class="fiat-currency-symbol" aria-hidden="true">$</span>
              <input id="crypto-custom-amount" type="text" inputmode="decimal" autocomplete="off" placeholder="0.00"
                aria-describedby="crypto-amount-help crypto-amount-error" data-crypto-custom-amount />
              <span class="fiat-currency-code">USD</span>
            </div>
          </label>
          <span class="fiat-field-help" id="crypto-amount-help">$1–$1,000 USD. Up to two decimal places.</span>
          <span class="fiat-field-error" id="crypto-amount-error" data-crypto-amount-error aria-live="polite" hidden></span>
        </div>
        <div class="fiat-checkout-summary">
          <div class="fiat-checkout-total"><span>SUPPORT AMOUNT</span><strong data-crypto-selected-amount>$0.00</strong></div>
          <button class="fiat-checkout-button" type="button" data-crypto-amount-continue disabled>
            <span>CHOOSE CURRENCY</span><i class="ph ph-arrow-right" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>

    <div class="fiat-step" data-crypto-step="currency" aria-hidden="true" hidden>
      <div class="fiat-step-heading">
        <span class="fiat-step-index">03 / 04</span>
        <h2 tabindex="-1">Choose A Currency</h2>
        <p><strong data-crypto-currency-amount>$0.00</strong> USD support as <strong data-crypto-supporter-name>Anonymous</strong>.</p>
      </div>
      <button class="fiat-amount-back" type="button" data-crypto-edit="amount">
        <i class="ph ph-arrow-left" aria-hidden="true"></i><span>CHANGE AMOUNT</span>
      </button>
      <fieldset class="crypto-currency-list">
        <legend class="crypto-legend">PAYMENT CURRENCY / NETWORK</legend>
        {currencies.map(currency => (
          <label class="crypto-currency-option">
            <input type="radio" name="crypto-currency" value={currency.asset} data-crypto-currency
              data-network={currency.network} data-symbol={currency.symbol} checked={currency.asset === 'ltc'} />
            <span class="crypto-currency-name">{currency.name} {currency.asset === 'ltc' && <small class="crypto-preferred">PREFERRED</small>}</span>
            <span class="crypto-currency-meta">{currency.symbol} / {currency.network.toUpperCase()}</span>
          </label>
        ))}
      </fieldset>
      <p class="fiat-field-help">USDC and USDT payments use Solana. Send only the selected asset on the displayed network.</p>
      <div class="fiat-checkout-summary">
        <div class="fiat-checkout-total"><span>SUPPORT AMOUNT</span><strong data-crypto-selected-amount>$0.00</strong></div>
        <button class="fiat-checkout-button" type="button" data-crypto-create>
          <span data-crypto-create-label>CREATE PAYMENT</span><i class="ph ph-arrow-right" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="fiat-step" data-crypto-step="payment" aria-hidden="true" hidden>
      <div class="fiat-step-heading">
        <span class="fiat-step-index">04 / 04</span>
        <h2 tabindex="-1">Send Your Payment</h2>
        <p>Supporting as <strong data-crypto-supporter-name>Anonymous</strong> with <strong data-crypto-selected-amount>$0.00</strong> USD.</p>
      </div>
      <p class="crypto-sandbox" data-crypto-sandbox hidden>SANDBOX TEST / DO NOT SEND REAL FUNDS</p>
      <div class="crypto-payment-details">
        <div class="crypto-payment-row"><span>SEND EXACTLY</span><strong><code data-crypto-pay-amount></code> <span data-crypto-pay-symbol></span></strong></div>
        <div class="crypto-payment-row crypto-network"><span>NETWORK</span><strong data-crypto-pay-network></strong></div>
        <p class="fiat-field-help">Use this network only. A transfer on another network may be lost.</p>
        <div class="crypto-address-row">
          <div><span class="crypto-detail-label">PAYMENT ADDRESS</span><code class="crypto-address" data-crypto-pay-address></code></div>
          <button class="fiat-skip-action" type="button" data-crypto-copy>COPY ADDRESS</button>
        </div>
        <div class="crypto-payment-row"><span>PAYMENT REFERENCE</span><code data-crypto-payment-id></code></div>
        <div class="crypto-payment-row"><span>ORDER REFERENCE</span><code data-crypto-order-id></code></div>
        <p class="fiat-field-help" data-crypto-copy-feedback aria-live="polite"></p>
      </div>
      <Admonition type="note">
        <p>Awaiting provider confirmation. Creating a payment or sending funds does not confirm your contribution. Support appears on the board only after NOWPayments verifies final settlement. This page does not show live payment status.</p>
      </Admonition>
      <p class="fiat-field-help">Use this address for this payment only. Quotes can expire; reloading doesn't refresh them. If you've waited, contact me before sending.</p>
      <button class="fiat-primary-action" type="button" data-support-back><span>BACK TO SUPPORT</span><i class="ph ph-arrow-left" aria-hidden="true"></i></button>
    </div>

    <div class="crypto-message" data-crypto-message tabindex="-1" role="status" aria-live="polite" hidden></div>
    <p class="fiat-field-help" data-crypto-recovery hidden>Keep your order reference and contact me before trying again. Don't send funds to an address from an incomplete request.</p>
    <noscript><p class="fiat-field-error">Enable JavaScript to create a crypto payment.</p></noscript>
  </section>
</section>

<script>
  import '../../scripts/cryptoSupport.ts';
</script>
