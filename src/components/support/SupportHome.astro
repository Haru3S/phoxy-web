---
import '../../styles/supportHome.css';
---

<section
  class="support-view is-active"
  data-support-page="home"
>
  <header class="support-header">
    <h1>
      <span
        class="lens-text lens-interactive"
        data-text="Support"
      >
        Support
      </span>
    </h1>

    <span>PHOXY / FOX</span>
  </header>

  <div class="support-intro">
    <p>
      If you enjoy the stuff I make and want to
      throw something my way, you can support me
      here.
    </p>

    <p>
      Support is completely optional. Pick whichever
      method works best for you.
    </p>
  </div>

  <section
    class="support-methods"
    aria-label="Support methods"
  >
    <button
      class="support-method"
      type="button"
      data-open-support-page="fiat"
    >
      <span class="method-index">
        01
      </span>

      <span class="method-content">
        <span class="method-heading">
          <span class="method-title">
            Fiat
          </span>

          <span class="method-status">
            AVAILABLE
          </span>
        </span>

        <span class="method-description">
          Support with a card or digital wallet
          through Stripe.
        </span>

        <span class="method-meta">
          STRIPE / USD + INTERNATIONAL
        </span>
      </span>

      <span
        class="method-icon"
        aria-hidden="true"
      >
        <i class="ph ph-arrow-right"></i>
      </span>
    </button>

    <button
      class="support-method"
      type="button"
      data-open-support-page="crypto"
    >
      <span class="method-index">
        02
      </span>

      <span class="method-content">
        <span class="method-heading">
          <span class="method-title">
            Crypto
          </span>

          <span class="method-status">
            AVAILABLE
          </span>
        </span>

        <span class="method-description">
          I accept various commonly used
          cryptocurrencies. More obscure currencies
          aren't supported.
        </span>

        <span class="method-meta">
          DIRECT WALLET
        </span>
      </span>

      <span
        class="method-icon"
        aria-hidden="true"
      >
        <i class="ph ph-arrow-right"></i>
      </span>
    </button>

    <button
      class="support-method"
      type="button"
      data-open-support-page="tf2"
    >
      <span class="method-index">
        03
      </span>

      <span class="method-content">
        <span class="method-heading">
          <span class="method-title">
            TF2 Items
          </span>

          <span class="method-status">
            AVAILABLE
          </span>
        </span>

        <span class="method-description">
          Donate items directly through a Steam
          trade offer. This is for donations only,
          not item-for-item trades.
        </span>

        <span class="method-meta">
          STEAM TRADE OFFER
        </span>
      </span>

      <span
        class="method-icon"
        aria-hidden="true"
      >
        <i class="ph ph-arrow-right"></i>
      </span>
    </button>
  </section>
</section>