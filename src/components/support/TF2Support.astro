---
const tradeOfferUrl =
  'https://steamcommunity.com/tradeoffer/new/?partner=373436544&token=_I7wKC9-';
---

<section
  class="support-view"
  data-support-page="tf2"
  aria-hidden="true"
>
  <header class="detail-toolbar">
    <button
      class="back-button"
      type="button"
      data-support-back
    >
      <i
        class="ph ph-arrow-left"
        aria-hidden="true"
      ></i>

      <span>Back</span>
    </button>

    <span>STEAM / TF2</span>
  </header>

  <div class="detail-heading">
    <h1>
      <span
        class="lens-text lens-interactive"
        data-text="TF2 Items"
      >
        TF2 Items
      </span>
    </h1>

    <p>
      You can support me by sending TF2 items
      directly through a Steam trade offer.
    </p>
  </div>

  <section class="trade-info">
    <div class="trade-row">
      <span class="trade-label">
        TYPE
      </span>

      <strong>
        Donation Trade
      </strong>
    </div>

    <div class="trade-row warning">
      <span class="trade-label">
        IMPORTANT
      </span>

      <p>
        Please only offer items from your inventory.
        Do not request items from mine. This link is
        for donations, not regular item-for-item
        trading.
      </p>
    </div>

    <div class="trade-action">
      <div>
        <span class="trade-label">
          STEAM TRADE OFFER
        </span>

        <p>
          Opens my Steam trade offer page.
        </p>
      </div>

      <a
        class="trade-link"
        href={tradeOfferUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span>
          OPEN TRADE OFFER
        </span>

        <i
          class="ph ph-arrow-up-right"
          aria-hidden="true"
        ></i>
      </a>
    </div>
  </section>
</section>

<style>
  .support-view {
    display: none;

    width: 100%;

    padding: 0.75rem;
  }

  .support-view.is-active {
    display: block;
  }

  /*
   * SMALL UTILITY STRIP
   */

  .detail-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    margin-bottom:
      clamp(
        1.5rem,
        2.5vh,
        2.25rem
      );

    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.7rem;
    font-weight: 700;
  }

  .back-button {
    display: flex;
    align-items: center;

    gap: 0.45rem;

    padding: 0;

    border: 0;

    background: transparent;
    color: var(--color-fg);

    font: inherit;

    cursor: pointer;
  }

  .back-button span {
    position: relative;
  }

  .back-button span::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.15rem;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition:
      transform
      0.1s
      ease-out;
  }

  .back-button:hover
    span::after,
  .back-button:focus-visible
    span::after {
    transform: scaleX(1);
  }

  /*
   * TITLE / INTRO
   */

  .detail-heading {
    margin-bottom:
      clamp(
        2.5rem,
        5vh,
        4rem
      );
  }

  .detail-heading h1 {
    margin:
      0
      0
      clamp(
        3rem,
        7vh,
        6rem
      );

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        5rem,
        9vw,
        10rem
      );

    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
  }

  .detail-heading p {
    max-width: 36rem;

    margin: 0;

    font-family:
      "Inter Variable",
      sans-serif;

    font-size:
      clamp(
        1.1rem,
        1.5vw,
        1.55rem
      );

    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  /*
   * TRADE INFORMATION
   */

  .trade-info {
    width: 100%;

    border-top:
      1px
      solid
      var(--color-border);
  }

  .trade-row,
  .trade-action {
    display: grid;

    grid-template-columns:
      minmax(7rem, 0.3fr)
      minmax(0, 1fr);

    gap: 1rem;

    padding:
      1rem
      0;

    border-bottom:
      1px
      solid
      var(--color-border);
  }

  .trade-label,
  .trade-link {
    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.7rem;
    font-weight: 700;
  }

  .trade-row strong {
    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        1.4rem,
        2vw,
        2.2rem
      );

    line-height: 1;
  }

  .trade-row p,
  .trade-action p {
    max-width: 46ch;

    margin: 0;

    font-family:
      "Inter Variable",
      sans-serif;

    font-size: 0.95rem;
    line-height: 1.3;
  }

  /*
   * TRADE ACTION
   */

  .trade-action {
    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: end;
  }

  .trade-action .trade-label {
    display: block;

    margin-bottom: 0.5rem;
  }

  .trade-link {
    position: relative;

    display: flex;
    align-items: center;

    gap: 0.4rem;

    width: fit-content;

    color: var(--color-fg);

    text-decoration: none;
  }

  .trade-link span {
    position: relative;
  }

  .trade-link span::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.15rem;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition:
      transform
      0.1s
      ease-out;
  }

  .trade-link:hover
    span::after,
  .trade-link:focus-visible
    span::after {
    transform: scaleX(1);
  }

  .trade-link i {
    font-size: 1rem;

    transition:
      transform
      0.1s
      ease-out;
  }

  .trade-link:hover i,
  .trade-link:focus-visible i {
    transform:
      translate(
        0.12rem,
        -0.12rem
      );
  }

  @media (
    prefers-reduced-motion:
      reduce
  ) {
    .back-button span::after,
    .trade-link span::after,
    .trade-link i {
      transition: none;
    }
  }

  @media (max-width: 700px) {
    .detail-toolbar {
      margin-bottom: 1.5rem;
    }

    .detail-heading h1 {
      font-size:
        clamp(
          4.5rem,
          22vw,
          8rem
        );
    }

    .trade-row,
    .trade-action {
      grid-template-columns: 1fr;
    }
  }
</style>