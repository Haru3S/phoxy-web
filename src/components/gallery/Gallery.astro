---
import GalleryItem from './GalleryItem.astro';

import { gallery } from '../../data/gallery';

import '../../styles/gallery.css';

const sortedGallery =
  [...gallery].sort(
    (a, b) =>
      new Date(
        `${b.date}T00:00:00`
      ).getTime() -
      new Date(
        `${a.date}T00:00:00`
      ).getTime()
  );
---

<section
  id="gallery"
  class="gallery-section"
>
  <header class="gallery-header">
    <h2>
      <span
        class="lens-text lens-interactive scroll-emphasis"
        data-text="Gallery"
        data-scroll-emphasis
      >
        Gallery
      </span>
    </h2>
  </header>

  <div class="gallery-space"></div>

  <div
    class="gallery-rule"
    aria-hidden="true"
  ></div>

  <div class="gallery-wall-space"></div>

  <div
    class="gallery"
    data-gallery
  >
    {sortedGallery.map((item) => (
      <GalleryItem item={item} />
    ))}
  </div>

  <div
    class="gallery-bottom-space"
    aria-hidden="true"
  ></div>
</section>

<script>
  import '../../scripts/galleryEdges.ts';
</script>