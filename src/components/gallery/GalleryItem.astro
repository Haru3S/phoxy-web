---
import type { GalleryEntry } from '../../data/gallery';

interface Props {
  item: GalleryEntry;
}

const { item } = Astro.props;

const size = item.size ?? 'square';
---

<figure
  class="gallery-item"
  data-size={size}
>
  <img
    src={item.src}
    alt={item.alt}
    loading="lazy"
  />

  <figcaption class="gallery-info">
    <h3>{item.title}</h3>

    {(item.type || item.year) && (
      <p>
        {item.type}
        {item.type && item.year && ' · '}
        {item.year}
      </p>
    )}
  </figcaption>
</figure>

<style>
  .gallery-item {
    position: relative;

    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    margin: 0;

    overflow: hidden;

    background: var(--surface, #000);
  }

  /*
   * IMAGE
   */

  .gallery-item img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  /*
   * METADATA
   *
   * Kept in the document because the
   * information is useful, but hidden
   * visually for this first wall pass.
   *
   * We can turn this into the eventual
   * hover/focus treatment later.
   */

  .gallery-info {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);
    white-space: nowrap;

    border: 0;
  }
</style>