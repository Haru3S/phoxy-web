---
import type { GalleryEntry } from '../../data/gallery';

interface Props {
  item: GalleryEntry;
}

const { item } = Astro.props;

const size = item.size ?? 'square';

const formattedDate = new Intl.DateTimeFormat(
  'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }
).format(
  new Date(`${item.date}T00:00:00Z`)
);

const showAlt = size !== 'square';
---

<figure
  class="gallery-item"
  data-size={size}
  tabindex="0"
>
  <div class="gallery-artwork">
    <img
      src={item.src}
      alt={item.alt}
      loading="lazy"
    />

    <figcaption class="gallery-info">
      <dl>
        <div class="info-row">
          <dt>Title</dt>
          <dd>{item.title}</dd>
        </div>

        <div class="info-row">
          <dt>Date</dt>
          <dd>{formattedDate}</dd>
        </div>

        {showAlt && (
          <div class="info-row info-row-alt">
            <dt>Alt</dt>
            <dd>{item.alt}</dd>
          </div>
        )}
      </dl>
    </figcaption>
  </div>
</figure>

<style>
  /*
   * GALLERY ITEM
   */

  .gallery-item {
    position: relative;

    width: 100%;
    min-width: 0;

    margin: 0;

    overflow: visible;

    z-index: 0;

    outline: none;
  }

  /*
   * ARTWORK LAYER
   */

  .gallery-artwork {
    position: relative;

    width: 100%;

    overflow: hidden;

    background:
      var(--background, #000);

    transform:
      translateZ(0)
      scale(1);

    transform-origin:
      var(
        --gallery-transform-origin,
        center center
      );

    transition:
      transform 200ms cubic-bezier(
        0.2,
        0.8,
        0.2,
        1
      ),
      box-shadow 200ms ease-out;

    will-change:
      transform,
      box-shadow;
  }

  .gallery-item:hover,
  .gallery-item:focus-visible {
    z-index: 20;
  }

  /*
   * PICK IT UP / LOOK CLOSER
   */

  .gallery-item:hover .gallery-artwork,
  .gallery-item:focus-visible .gallery-artwork {
    transform:
      translateY(-8px)
      scale(1.16);

    box-shadow:
      0 28px 65px
      rgba(0, 0, 0, 0.68);
  }

  /*
   * IMAGE
   */

  .gallery-artwork img {
    display: block;

    width: 100%;
    height: auto;

    user-select: none;

    -webkit-user-drag: none;
  }

  /*
   * INFORMATION CARD
   *
   * Compact and secondary to the artwork.
   * It still expands horizontally when
   * longer metadata needs more room.
   */

  .gallery-info {
    position: absolute;

    left: 50%;

    bottom:
      clamp(
        0.5rem,
        1.75%,
        0.85rem
      );

    width: fit-content;

    min-width: 8.5rem;

    max-width: min(
      68%,
      calc(100% - 1rem)
    );

    padding:
      clamp(
        0.35rem,
        0.5vw,
        0.5rem
      );

    margin: 0;

    background:
      rgba(0, 0, 0, 0.5);

    backdrop-filter:
      blur(20px);

    -webkit-backdrop-filter:
      blur(20px);

    color:
      var(--foreground, #fff);

    opacity: 0;

    transform:
      translateX(-50%)
      translateY(7px);

    transition:
      opacity 140ms ease-out,
      transform 170ms ease-out;

    pointer-events: none;
  }

  .gallery-item:hover .gallery-info,
  .gallery-item:focus-visible .gallery-info {
    opacity: 1;

    transform:
      translateX(-50%)
      translateY(0);
  }

  /*
   * INFORMATION
   */

  .gallery-info dl {
    display: flex;
    flex-direction: column;

    width: max-content;
    max-width: 100%;

    gap: 0.14rem;

    margin: 0;
  }

  .info-row {
    display: grid;

    grid-template-columns:
      2.25rem
      minmax(0, max-content);

    gap:
      clamp(
        0.35rem,
        0.55vw,
        0.55rem
      );

    align-items: baseline;

    width: max-content;
    max-width: 100%;
  }

  .gallery-info dt,
  .gallery-info dd {
    margin: 0;

    font-family:
      "Adwaita Mono",
      monospace;

    font-size:
      clamp(
        0.62rem,
        0.66vw,
        0.76rem
      );

    line-height: 1.15;
  }

  .gallery-info dt {
    font-weight: 700;

    text-transform: uppercase;

    opacity: 0.65;

    white-space: nowrap;
  }

  .gallery-info dd {
    min-width: 0;

    font-weight: 400;

    white-space: nowrap;
  }

  /*
   * ALT CAN WRAP IF IT ACTUALLY NEEDS TO.
   */

  .info-row-alt {
    grid-template-columns:
      2.25rem
      minmax(0, 1fr);

    width: 100%;

    align-items: start;
  }

  .info-row-alt dd {
    white-space: normal;

    overflow-wrap: break-word;
  }

  /*
   * KEYBOARD FOCUS
   */

  .gallery-item:focus-visible
  .gallery-artwork {
    outline:
      1px
      solid
      var(--foreground, #fff);

    outline-offset: -1px;
  }

  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    .gallery-artwork,
    .gallery-info {
      transition: none;
    }

    .gallery-item:hover .gallery-artwork,
    .gallery-item:focus-visible .gallery-artwork {
      transform: none;
    }

    .gallery-item:hover .gallery-info,
    .gallery-item:focus-visible .gallery-info {
      transform:
        translateX(-50%);
    }
  }

  /*
   * MOBILE
   */

  @media (max-width: 700px) {
    .gallery-item:hover .gallery-artwork,
    .gallery-item:focus-visible .gallery-artwork {
      transform:
        translateY(-3px)
        scale(1.05);
    }

    .gallery-info {
      bottom: 0.35rem;

      min-width: 0;

      max-width:
        calc(100% - 0.75rem);

      padding: 0.35rem;
    }

    .info-row {
      grid-template-columns:
        2.15rem
        minmax(0, max-content);

      gap: 0.3rem;
    }

    .info-row-alt {
      grid-template-columns:
        2.15rem
        minmax(0, 1fr);
    }

    .gallery-info dt,
    .gallery-info dd {
      font-size: 0.6rem;
    }
  }
</style>