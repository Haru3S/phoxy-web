---
import type { GalleryEntry } from '../../data/gallery';

interface Props {
  item: GalleryEntry;
}

const { item } = Astro.props;

const size = item.size ?? 'square';

const year = new Date(
  `${item.date}T00:00:00`
).getFullYear();
---

<figure
  class="gallery-item"
  data-size={size}
>
  <img
    src={item.src}
    alt={item.alt}
    loading="lazy"
  />

  <figcaption class="gallery-info">
    <h3>{item.title}</h3>

    {(item.type || year) && (
      <p>
        {item.type}
        {item.type && year && ' · '}
        {year}
      </p>
    )}
  </figcaption>
</figure>

<style>
  .gallery-item {
    position: relative;

    width: 100%;
    min-width: 0;

    margin: 0;

    overflow: hidden;

    background:
      var(--background, #000);
  }

  /*
   * Keep the artwork's natural aspect ratio.
   *
   * No cropping.
   * No contain letterboxing.
   * No forced tile height.
   */

  .gallery-item img {
    display: block;

    width: 100%;
    height: auto;
  }

  /*
   * METADATA
   *
   * Hidden visually for now.
   */

  .gallery-info {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);
    white-space: nowrap;

    border: 0;
  }
</style>