---
import Layout from '../layouts/Layout.astro';
import NotFoundVisual from '../components/404/404Visual.astro';

import '../styles/404.css';
---

<Layout
  title="404 — Phoxy Fox"
  description="That page doesn't exist."
>
  <main class="not-found-page">
    <NotFoundVisual />

    <a
      class="home-link"
      href="/"
      aria-label="Return home"
    >
      <i
        class="ph ph-arrow-left"
        aria-hidden="true"
      ></i>

      <span>Home</span>
    </a>

    <section
      class="not-found-content"
      aria-labelledby="not-found-title"
    >
      <h1
        id="not-found-title"
        class="glitch-title lens-text lens-extreme"
        data-text="404"
        data-glitch-text="404"
        data-error-trigger
        role="button"
        tabindex="0"
        aria-label="Trigger error"
        data-ui-sound="off"
      >
        404
      </h1>

      <p
        class="glitch-subtitle"
        data-glitch-text="console: get s.interlope.pull:27015"
      >
        console: get s.interlope.pull:27015
      </p>
    </section>

    <aside
      class="now-playing"
      aria-label="Now playing"
    >
      <span class="now-playing-label">
        Now Playing
      </span>

      <span class="now-playing-track">
        sourcebox.dll · Pumodi
      </span>

      <span class="now-playing-album">
        Interloper Volume 2 (Original Soundtrack)
      </span>
    </aside>
  </main>
</Layout>

<script>
  import '../scripts/notFoundGlitch.ts';
</script>