---
import Layout from '../layouts/Layout.astro';
import NotFoundVisual from '../components/404/404Visual.astro';

import '../styles/404.css';

const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';
---

<Layout
  title="404 | Phoxy"
  description="That page doesn't exist."
>
  <main class="not-found-page">
    <NotFoundVisual />

    <a
      class="home-link"
      href={base}
      aria-label="Return home"
    >
      <i
        class="ph ph-arrow-left"
        aria-hidden="true"
      ></i>

      <span>Home</span>
    </a>

    <section
      class="not-found-content"
      aria-labelledby="not-found-title"
    >
      <h1
        id="not-found-title"
        class="glitch-title lens-text lens-extreme"
        data-text="404"
        data-glitch-text="404"
      >
        404
      </h1>

      <p
        class="glitch-subtitle"
        data-glitch-text="welcome to the twilight zone."
      >
        welcome to the twilight zone.
      </p>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/notFoundGlitch.ts';
</script>