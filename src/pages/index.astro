---
import Layout from '../layouts/Layout.astro';

import Hero from '../components/hero/Hero.astro';

import MainNav from '../components/navigation/MainNav.astro';

import ProjectCard from '../components/projects/ProjectCard.astro';

import Work from '../components/work/Work.astro';

import GalleryItem from '../components/gallery/GalleryItem.astro';

import { projects } from '../data/projects';

import { gallery } from '../data/gallery';

const sortedGallery = [...gallery].sort(
  (a, b) =>
    new Date(`${b.date}T00:00:00`).getTime() -
    new Date(`${a.date}T00:00:00`).getTime()
);
---

<Layout title="Phoxy">
  <main class="home-load-enter">
    <!-- Hero -->
    <div class="home-load-motion">
      <Hero />
    </div>

    <!-- Who Am I -->
    <section id="about" class="about">
      <div class="about-art">
        <img
          src="/assets/animations/fc3s.gif"
          alt=""
        />
      </div>

      <div class="about-content">
        <p class="about-intro">
          Yo, sup! I'm kinda a big deal! Grass grows, sun shines, birds fly, and brotha'—
          I make stuff, think outside the box!
        </p>

        <h2
          class="about-heading scroll-emphasis"
          data-scroll-emphasis
        >
          <span
            class="lens-text lens-interactive"
            data-text="That's"
          >
            That's
          </span>

          <span
            class="lens-text lens-interactive"
            data-text="Who I Am"
          >
            Who I Am
          </span>
        </h2>
      </div>
    </section>

    <!-- Links / Navigation -->
    <MainNav />

    <!-- Projects -->
    <section id="projects" class="projects-section">
      <h2>
        <span
          class="lens-text lens-interactive scroll-emphasis"
          data-text="Projects"
          data-scroll-emphasis
        >
          Projects
        </span>
      </h2>

      <div class="projects">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
          />
        ))}
      </div>
    </section>

    <!-- Work -->
    <Work />

    <!-- Contact -->
    <section id="contact">
      <h2>Contact</h2>
    </section>

    <!-- Interests -->
    <section id="interests">
      <h2>Interests</h2>
    </section>

    <!-- Gallery -->
    <section
      id="gallery"
      class="gallery-section"
    >
      <header class="gallery-header">
        <h2>
          <span
            class="lens-text lens-interactive scroll-emphasis"
            data-text="Gallery"
            data-scroll-emphasis
          >
            Gallery
          </span>
        </h2>
      </header>

      <div class="gallery-space"></div>

      <div
        class="gallery-rule"
        aria-hidden="true"
      ></div>

      <div class="gallery-wall-space"></div>

      <div
        class="gallery"
        data-gallery
      >
        {sortedGallery.map((item) => (
          <GalleryItem item={item} />
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
  /**
   * SCROLL EMPHASIS
   *
   * Homepage headings form a directional
   * progression while scrolling downward.
   *
   * A heading activates only after reaching
   * the lower-middle reading area.
   *
   * Only one heading may be active at once.
   *
   * Scrolling upward does not activate
   * headings. It only allows the currently
   * active heading to return to rest once
   * it leaves the viewport.
   */

  const scrollEmphasisElements =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-scroll-emphasis]'
      )
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  let activeScrollEmphasis:
    HTMLElement | null = null;

  let previousScrollY =
    window.scrollY;

  /**
   * The heading activates when its center
   * reaches this percentage of the viewport.
   *
   * Larger number = later / farther down.
   */

  const activationLine = 0.67;

  const deactivateScrollEmphasis = () => {
    if (!activeScrollEmphasis) {
      return;
    }

    activeScrollEmphasis.classList.remove(
      'is-scroll-active'
    );

    activeScrollEmphasis = null;
  };

  const activateScrollEmphasis = (
    element: HTMLElement
  ) => {
    if (
      activeScrollEmphasis === element
    ) {
      return;
    }

    if (activeScrollEmphasis) {
      activeScrollEmphasis.classList.remove(
        'is-scroll-active'
      );
    }

    element.classList.add(
      'is-scroll-active'
    );

    activeScrollEmphasis = element;
  };

  const updateScrollEmphasis = () => {
    if (
      scrollEmphasisElements.length === 0 ||
      reducedMotion.matches
    ) {
      deactivateScrollEmphasis();

      previousScrollY =
        window.scrollY;

      return;
    }

    const currentScrollY =
      window.scrollY;

    const scrollingDown =
      currentScrollY >
      previousScrollY;

    const viewportHeight =
      window.innerHeight;

    const triggerY =
      viewportHeight *
      activationLine;

    /**
     * If the active heading has completely
     * left the viewport, return it to rest.
     */

    if (activeScrollEmphasis) {
      const activeRect =
        activeScrollEmphasis
          .getBoundingClientRect();

      const isInView =
        activeRect.bottom > 0 &&
        activeRect.top < viewportHeight;

      if (!isInView) {
        deactivateScrollEmphasis();
      }
    }

    /**
     * New headings can ONLY activate while
     * moving downward.
     */

    if (scrollingDown) {
      let candidate:
        HTMLElement | null = null;

      let closestDistance =
        Number.POSITIVE_INFINITY;

      for (
        const element
        of scrollEmphasisElements
      ) {
        const rect =
          element.getBoundingClientRect();

        const center =
          rect.top +
          rect.height / 2;

        /**
         * Only consider headings currently
         * visible in the viewport.
         */

        const isInView =
          rect.bottom > 0 &&
          rect.top < viewportHeight;

        if (!isInView) {
          continue;
        }

        /**
         * The heading must have reached the
         * activation line before it can become
         * the active stage of the progression.
         */

        if (center > triggerY) {
          continue;
        }

        const distance =
          triggerY - center;

        /**
         * Choose the heading that most recently
         * crossed the activation line.
         */

        if (
          distance <
          closestDistance
        ) {
          candidate =
            element;

          closestDistance =
            distance;
        }
      }

      if (
        candidate &&
        candidate !==
          activeScrollEmphasis
      ) {
        activateScrollEmphasis(
          candidate
        );
      }
    }

    previousScrollY =
      currentScrollY;
  };

  /**
   * Use requestAnimationFrame so scroll
   * events never directly perform layout
   * work more than once per frame.
   */

  let scrollFrame:
    number | null = null;

  const requestScrollUpdate = () => {
    if (scrollFrame !== null) {
      return;
    }

    scrollFrame =
      requestAnimationFrame(() => {
        updateScrollEmphasis();

        scrollFrame = null;
      });
  };

  if (
    scrollEmphasisElements.length > 0
  ) {
    window.addEventListener(
      'scroll',
      requestScrollUpdate,
      { passive: true }
    );

    window.addEventListener(
      'resize',
      requestScrollUpdate
    );

    reducedMotion.addEventListener(
      'change',
      requestScrollUpdate
    );
  }

  /**
   * GALLERY EDGE DETECTION
   *
   * Enlarged artwork touching either side
   * of the viewport grows inward instead
   * of spilling off-screen.
   */

  const gallery =
    document.querySelector<HTMLElement>(
      '[data-gallery]'
    );

  if (gallery) {
    const updateGalleryEdges = () => {
      const items =
        gallery.querySelectorAll<HTMLElement>(
          '.gallery-item'
        );

      const galleryRect =
        gallery.getBoundingClientRect();

      const tolerance = 2;

      for (const item of items) {
        const rect =
          item.getBoundingClientRect();

        const touchesLeft =
          Math.abs(
            rect.left -
            galleryRect.left
          ) <= tolerance;

        const touchesRight =
          Math.abs(
            rect.right -
            galleryRect.right
          ) <= tolerance;

        if (
          touchesLeft &&
          touchesRight
        ) {
          item.style.setProperty(
            '--gallery-transform-origin',
            'center center'
          );

          continue;
        }

        if (touchesLeft) {
          item.style.setProperty(
            '--gallery-transform-origin',
            'left center'
          );

          continue;
        }

        if (touchesRight) {
          item.style.setProperty(
            '--gallery-transform-origin',
            'right center'
          );

          continue;
        }

        item.style.setProperty(
          '--gallery-transform-origin',
          'center center'
        );
      }
    };

    updateGalleryEdges();

    const resizeObserver =
      new ResizeObserver(() => {
        updateGalleryEdges();
      });

    resizeObserver.observe(gallery);

    window.addEventListener(
      'resize',
      updateGalleryEdges
    );
  }
</script>

<style>
  /**
   * HOMEPAGE LOAD ENTRANCE
   *
   * The homepage itself fades as one document,
   * while only the Hero artwork receives the
   * upward movement.
   *
   * This deliberately avoids translating the
   * <main> element because the Hero contains a
   * viewport-fixed scroll indicator.
   */

  :global(.js) .home-load-enter {
    opacity: 0;

    transition:
      opacity
        var(--load-enter-duration)
        var(--load-enter-easing);
  }

  :global(.js.page-ready) .home-load-enter {
    opacity: 1;
  }

  :global(.js) .home-load-motion {
    translate:
      0
      var(--load-enter-distance);

    transition:
      translate
        var(--load-enter-duration)
        var(--load-enter-easing);
  }

  :global(.js.page-ready) .home-load-motion {
    translate: 0 0;
  }

  /**
   * WHO AM I
   */

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;

    width: 100%;
    height: 70vh;
    min-height: 600px;

    overflow: hidden;
  }

  /**
   * ARTWORK
   */

  .about-art {
    position: relative;

    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    overflow: hidden;

    border-right:
      1px
      solid
      var(--border, #111);
  }

  .about-art img {
    position: absolute;

    inset:
      50%
      auto
      auto
      50%;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;

    translate: -50% -50%;
  }

  /**
   * CONTENT
   */

  .about-content {
    display: grid;
    grid-template-rows: auto 1fr auto;

    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    padding:
      clamp(
        0.5rem,
        0.7vw,
        0.875rem
      );
  }

  .about-intro {
    grid-row: 1;

    width: 100%;
    max-width: 17ch;

    margin: 0;

    font-family:
      "Inter Variable",
      sans-serif;

    font-size:
      clamp(
        2.5rem,
        3.5vw,
        4.5rem
      );

    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  /**
   * ABOUT HEADING
   */

  .about-heading {
    grid-row: 3;
    align-self: end;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    margin: 0;

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        5rem,
        8.5vw,
        10rem
      );

    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
  }

  .about-heading .lens-text {
    display: block;

    width: fit-content;

    white-space: nowrap;

    transform: scaleX(1.28);
    transform-origin: left bottom;
  }

  /**
   * PROJECTS
   */

  .projects-section {
    width: 100%;

    padding-top:
      clamp(
        4rem,
        10vw,
        10rem
      );
  }

  .projects-section > h2 {
    margin: 0;

    padding:
      0
      1.5rem
      0.2em;

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        4rem,
        10vw,
        10rem
      );

    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  /**
   * GALLERY
   */

  .gallery-section {
    width: 100%;

    padding-top:
      clamp(
        2rem,
        3vw,
        3rem
      );
  }

  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;

    width: 100%;

    padding:
      0
      1.5rem
      0.35rem;
  }

  .gallery-header h2 {
    margin: 0;

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        5rem,
        12vw,
        12rem
      );

    font-weight: 600;
    line-height: 0.82;
    letter-spacing: -0.06em;

    text-align: right;
  }

  /**
   * SPACE BETWEEN TEXT AND RULE
   */

  .gallery-space {
    width: 100%;

    height:
      clamp(
        2.25rem,
        3.5vw,
        4rem
      );
  }

  /**
   * SINGLE GALLERY RULE
   */

  .gallery-rule {
    width: 100%;
    height: 3px;

    background:
      var(--foreground, #fff);
  }

  /**
   * SPACE BETWEEN RULE AND ARTWORK
   */

  .gallery-wall-space {
    width: 100%;

    height:
      clamp(
        2rem,
        3vw,
        3.4rem
      );
  }

  /**
   * ART WALL
   */

  .gallery {
    --gallery-gap: 1px;

    display: grid;

    grid-template-columns:
      repeat(
        12,
        minmax(0, 1fr)
      );

    grid-auto-flow: dense;

    align-items: start;

    width: 100%;

    margin: 0;
    padding: 0;

    gap:
      var(--gallery-gap);

    overflow: visible;

    background:
      var(--background, #000);
  }

  /**
   * TILE WIDTHS
   */

  .gallery > :global([data-size="square"]) {
    grid-column: span 3;
  }

  .gallery > :global([data-size="wide"]) {
    grid-column: span 6;
  }

  .gallery > :global([data-size="tall"]) {
    grid-column: span 3;
  }

  .gallery > :global([data-size="large"]) {
    grid-column: span 6;
  }

  /**
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .home-load-enter,
    :global(.js.page-ready) .home-load-enter {
      opacity: 1;

      transition: none;
    }

    :global(.js) .home-load-motion,
    :global(.js.page-ready) .home-load-motion {
      translate: 0 0;

      transition: none;
    }
  }

  /**
   * MOBILE
   */

  @media (max-width: 700px) {
    .about {
      grid-template-columns: 1fr;

      height: auto;
      min-height: 0;

      overflow: visible;
    }

    .about-art {
      height: auto;

      aspect-ratio: 4 / 3;

      border-right: 0;

      border-bottom:
        1px
        solid
        var(--border, #111);
    }

    .about-content {
      min-height: 60vh;

      padding: 0.75rem;
    }

    .about-intro {
      max-width: 18ch;

      font-size:
        clamp(
          2rem,
          8vw,
          3rem
        );

      font-weight: 400;
    }

    .about-heading {
      font-size:
        clamp(
          4rem,
          17vw,
          7rem
        );
    }

    .about-heading .lens-text {
      transform: scaleX(1.08);
      transform-origin: left bottom;
    }

    /**
     * MOBILE GALLERY
     */

    .gallery-section {
      padding-top: 2rem;
    }

    .gallery-header {
      justify-content: flex-end;

      padding:
        0
        1rem
        0.3rem;
    }

    .gallery-header h2 {
      font-size:
        clamp(
          4.5rem,
          22vw,
          8rem
        );

      text-align: right;
    }

    .gallery-space {
      height: 2rem;
    }

    .gallery-rule {
      height: 2px;
    }

    .gallery-wall-space {
      height: 1.75rem;
    }

    .gallery {
      grid-template-columns:
        repeat(
          4,
          minmax(0, 1fr)
        );
    }

    .gallery > :global([data-size="square"]),
    .gallery > :global([data-size="tall"]) {
      grid-column: span 2;
    }

    .gallery > :global([data-size="wide"]),
    .gallery > :global([data-size="large"]) {
      grid-column: span 4;
    }
  }
</style>