---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/hero/Hero.astro';
import MainNav from '../components/navigation/MainNav.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import GalleryItem from '../components/gallery/GalleryItem.astro';

import { projects } from '../data/projects';
import { gallery } from '../data/gallery';
---

<Layout title="Phoxy">
  <main>
    <!-- Hero -->
    <Hero />

    <!-- Who Am I -->
    <section id="about" class="about">
      <div class="about-art">
        <img
          src="/assets/dev/Debugempty.png"
          alt=""
        />
      </div>

      <div class="about-content">
        <p class="about-intro">
          Yo, sup! I'm kinda a big deal! Grass grows, sun shines, birds fly, and brotha'—
          I make stuff, think outside the box!
        </p>

        <h2 class="about-heading">
          <span>That's</span>
          <span>Who I Am</span>
        </h2>
      </div>
    </section>

    <!-- Links / Navigation -->
    <MainNav />

    <!-- Projects -->
    <section id="projects" class="projects-section">
      <h2>Projects</h2>

      <div class="projects">
        {projects.map((project, index) => (
          <ProjectCard
            project={project}
            index={index}
          />
        ))}
      </div>
    </section>

    <!-- Contact -->
    <section id="contact">
      <h2>Contact</h2>
    </section>

    <!-- Interests -->
    <section id="interests">
      <h2>Interests</h2>
    </section>

    <!-- Gallery -->
    <section id="gallery">
      <h2>Gallery</h2>

      <div class="gallery">
        {gallery.map((item) => (
          <GalleryItem item={item} />
        ))}
      </div>
    </section>
  </main>
</Layout>

<style>
  /*
   * WHO AM I
   */

  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;

    width: 100%;
    height: 70vh;
    min-height: 600px;

    overflow: hidden;
  }

  /*
   * ARTWORK
   */

  .about-art {
    position: relative;

    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    overflow: hidden;

    border-right: 1px solid #111;
  }

  .about-art img {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  /*
   * CONTENT
   */

  .about-content {
    display: grid;
    grid-template-rows: auto 1fr auto;

    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;

    padding: clamp(0.5rem, 0.7vw, 0.875rem);
  }

  .about-intro {
    grid-row: 1;

    width: 100%;
    max-width: 17ch;

    margin: 0;

    font-family: "Inter Variable", sans-serif;
    font-size: clamp(2.5rem, 3.5vw, 4.5rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  /*
   * HEADING
   */

  .about-heading {
    grid-row: 3;
    align-self: end;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    margin: 0;

    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(5rem, 8.5vw, 10rem);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
  }

  .about-heading span {
    display: block;

    width: fit-content;

    white-space: nowrap;

    transform: scaleX(1.28);
    transform-origin: left bottom;
  }

  /*
   * PROJECTS
   */

  .projects-section {
    width: 100%;

    padding-top: clamp(4rem, 10vw, 10rem);
  }

  .projects-section > h2 {
    margin: 0;
    padding: 0 1.5rem 0.2em;

    font-family: "Space Grotesk Variable", sans-serif;
    font-size: clamp(4rem, 10vw, 10rem);
    font-weight: 600;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  /*
   * MOBILE
   */

  @media (max-width: 700px) {
    .about {
      grid-template-columns: 1fr;

      height: auto;
      min-height: 0;

      overflow: visible;
    }

    .about-art {
      height: auto;
      aspect-ratio: 4 / 3;

      border-right: 0;
      border-bottom: 1px solid #111;
    }

    .about-content {
      min-height: 60vh;

      padding: 0.75rem;
    }

    .about-intro {
      max-width: 18ch;

      font-size: clamp(2rem, 8vw, 3rem);
      font-weight: 400;
    }

    .about-heading {
      font-size: clamp(4rem, 17vw, 7rem);
    }

    .about-heading span {
      transform: scaleX(1.08);
      transform-origin: left bottom;
    }
  }
</style>