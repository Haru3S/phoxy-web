---
import Layout from '../layouts/Layout.astro';

import Hero from '../components/hero/Hero.astro';
import About from '../components/about/About.astro';
import MainNav from '../components/navigation/MainNav.astro';
import Projects from '../components/projects/Projects.astro';
import Work from '../components/work/Work.astro';
import Contact from '../components/contact/Contact.astro';
import Gallery from '../components/gallery/Gallery.astro';
---

<Layout title="Phoxy">
  <main class="home-load-enter">
    <!-- Hero -->
    <div class="home-load-motion">
      <Hero />
    </div>

    <!-- Who Am I -->
    <About />

    <!-- Links / Navigation -->
    <MainNav />

    <!-- Projects -->
    <Projects />

    <!-- Work -->
    <Work />

    <!-- Contact -->
    <section id="contact">
      <Contact />
    </section>

    <!-- Interests -->
    <section id="interests">
      <h2>Interests</h2>
    </section>

    <!-- Gallery -->
    <Gallery />
  </main>
</Layout>

<script>
  import '../scripts/scrollEmphasis.ts';
</script>

<style>
  /*
   * HOMEPAGE LOAD ENTRANCE
   *
   * The homepage itself fades as one document,
   * while only the Hero artwork receives the
   * upward movement.
   *
   * This deliberately avoids translating the
   * <main> element because the Hero contains a
   * viewport-fixed scroll indicator.
   */

  :global(.js) .home-load-enter {
    opacity: 0;

    transition:
      opacity
        var(--load-enter-duration)
        var(--load-enter-easing);
  }

  :global(.js.page-ready) .home-load-enter {
    opacity: 1;
  }

  :global(.js) .home-load-motion {
    translate:
      0
      var(--load-enter-distance);

    transition:
      translate
        var(--load-enter-duration)
        var(--load-enter-easing);
  }

  :global(.js.page-ready) .home-load-motion {
    translate: 0 0;
  }

  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .home-load-enter,
    :global(.js.page-ready) .home-load-enter {
      opacity: 1;

      transition: none;
    }

    :global(.js) .home-load-motion,
    :global(.js.page-ready) .home-load-motion {
      translate: 0 0;

      transition: none;
    }
  }
</style>