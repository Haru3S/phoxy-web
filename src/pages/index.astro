---
import Layout from '../layouts/Layout.astro';

import Hero from '../components/hero/Hero.astro';
import About from '../components/about/About.astro';
import MainNav from '../components/navigation/MainNav.astro';
import Projects from '../components/projects/Projects.astro';
import Work from '../components/work/Work.astro';
import Contact from '../components/contact/Contact.astro';
import Gallery from '../components/gallery/Gallery.astro';
import Footer from '../components/footer/Footer.astro';

import '../styles/index.css';
---

<Layout title="Phoxy">
  <main
    id="top"
    class="home-load-enter"
  >
    <!-- Hero -->
    <div class="home-load-motion">
      <Hero />
    </div>

    <!-- Who Am I -->
    <About />

    <!-- Links / Navigation -->
    <MainNav />

    <!-- Projects -->
    <Projects />

    <!-- Work -->
    <Work />

    <!-- Contact -->
    <section id="contact">
      <Contact />
    </section>

    <!-- Interests -->
    <section id="interests">
      <h2>Interests</h2>
    </section>

    <!-- Gallery -->
    <Gallery />

    <!-- Footer -->
    <Footer />
  </main>
</Layout>

<script>
  import '../scripts/scrollEmphasis.ts';
</script>