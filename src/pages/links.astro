---
import Layout from '../layouts/Layout.astro';

import LinkCard from '../components/links/LinkCard.astro';
import LinkVisual from '../components/links/LinkVisual.astro';
import PageNav from '../components/navigation/PageNav.astro';

import { links } from '../data/links';

import '../styles/links.css';

const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';
---

<Layout title="Links — Phoxy">
  <main class="links-page">
    <!-- Left Side -->
    <section class="links-panel load-enter">
      <div
        class="links-scroll-shell"
        data-scroll-shell
      >
        <div
          class="links-scroll-region"
          data-scroll-region
        >
          <div class="links-content">
            <header class="links-header">
              <h1>
                <span
                  class="lens-text lens-interactive"
                  data-text="Links"
                >
                  Links
                </span>
              </h1>

              <span>PHOXY / FOX</span>
            </header>

            <div
              class="links-column-header"
              aria-hidden="true"
            >
              <span>ICON</span>
              <span>NAME</span>
              <span>TYPE</span>
            </div>

            <div class="links-list">
              {links.map((link) => (
                <LinkCard link={link} />
              ))}
            </div>
          </div>
        </div>

        <!-- Bottom Scroll Fade -->
        <div
          class="scroll-fade"
          data-scroll-fade
          aria-hidden="true"
        ></div>

        <!-- Desktop Scroll Affordance -->
        <button
          class="scroll-indicator"
          type="button"
          data-scroll-indicator
          aria-label="Scroll for more links"
          tabindex="-1"
        >
          <i
            class="ph ph-caret-down"
            aria-hidden="true"
          ></i>
        </button>
      </div>

      <PageNav
        first={{
          label: 'Support',
          href: `${base}support`,
          icon: 'tip-jar',
        }}
        second={{
          label: 'Home',
          href: base,
          icon: 'house',
        }}
      />
    </section>

    <!-- Procedural ASCII Galaxy -->
    <section
      class="links-visual visual-enter"
      aria-label="Procedural ASCII galaxy"
    >
      <LinkVisual />
    </section>
  </main>
</Layout>

<script>
  import '../scripts/linksScroll.ts';
</script>