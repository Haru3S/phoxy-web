---
import Layout from '../layouts/Layout.astro';

import PageNav from '../components/navigation/PageNav.astro';

import SupporterDisplay from '../components/support/SupporterDisplay.astro';
import SupportVisual from '../components/support/SupportVisual.astro';
import SupportHome from '../components/support/SupportHome.astro';
import CryptoSupport from '../components/support/CryptoSupport.astro';
import TF2Support from '../components/support/TF2Support.astro';

import '../styles/support.css';

const base =
  import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';
---

<Layout title="Support — Phoxy Fox">
  <main class="support-page">
    <section class="support-visual-panel">
      <!--
        Supporter information participates in
        the shared UI entrance.
      -->
      <div class="supporter-load load-enter">
        <SupporterDisplay />
      </div>

      <!--
        The koi pond renders immediately while
        hidden, then fades in after the UI.
      -->
      <div class="support-visual-load visual-enter">
        <SupportVisual />
      </div>
    </section>

    <!--
      The entire functional side enters together,
      including its navigation.
    -->
    <section class="support-content-panel load-enter">
      <div
        class="support-scroll-shell"
        data-scroll-shell
      >
        <div
          class="support-scroll-region"
          data-scroll-region
        >
          <SupportHome />
          <CryptoSupport />
          <TF2Support />
        </div>

        <!-- Bottom Scroll Fade -->
        <div
          class="scroll-fade"
          data-scroll-fade
          aria-hidden="true"
        ></div>

        <!-- Desktop Scroll Affordance -->
        <button
          class="scroll-indicator"
          type="button"
          data-scroll-indicator
          aria-label="Scroll for more content"
          tabindex="-1"
        >
          <i
            class="ph ph-caret-down"
            aria-hidden="true"
          ></i>
        </button>
      </div>

      <PageNav
        first={{
          label: 'Links',
          href: `${base}links`,
          icon: 'link',
        }}
        second={{
          label: 'Home',
          href: base,
          icon: 'house',
        }}
      />
    </section>
  </main>
</Layout>

<script>
  import '../scripts/supportNavigation.ts';
</script>