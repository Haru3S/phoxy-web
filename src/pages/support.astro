---
import Layout from '../layouts/Layout.astro';
import PageNav from '../components/navigation/PageNav.astro';

/*
 * DEVELOPMENT DATA
 *
 * Temporary data for composing the Support page.
 * This will eventually be replaced by verified
 * supporter data from the backend.
 */

const recentSupport = [
  {
    name: 'TreeCreature',
    amount: 5,
    time: '2m ago',
  },
  {
    name: 'Anonymous',
    amount: 10,
    time: '8m ago',
  },
  {
    name: 'PhoxyEnjoyer',
    amount: 2.5,
    time: '34m ago',
  },
  {
    name: 'CoolPerson',
    amount: 20,
    time: '1h ago',
  },
  {
    name: 'Anonymous',
    amount: 4,
    time: '3h ago',
  },
];

const totalSupport = [
  {
    name: 'TreeCreature',
    value: 14,
  },
  {
    name: 'PhoxyEnjoyer',
    value: 9,
  },
  {
    name: 'CoolPerson',
    value: 6,
  },
  {
    name: 'Anonymous',
    value: 5,
  },
];

const amountSupport = [
  {
    name: 'TreeCreature',
    value: 120,
  },
  {
    name: 'CoolPerson',
    value: 84,
  },
  {
    name: 'PhoxyEnjoyer',
    value: 57.5,
  },
  {
    name: 'Anonymous',
    value: 32,
  },
];
---

<Layout title="Support — Phoxy">
  <main class="support-page">
    <!-- Left Side -->
    <section class="support-visual-panel">
      <!-- Supporter Display -->
      <section class="supporters">
        <header class="supporters-header">
          <span>SUPPORTERS</span>

          <nav
            class="supporter-tabs"
            aria-label="Supporter views"
          >
            <button
              type="button"
              class="supporter-tab is-active"
              data-support-tab="recent"
              aria-pressed="true"
            >
              Recent
            </button>

            <button
              type="button"
              class="supporter-tab"
              data-support-tab="total"
              aria-pressed="false"
            >
              Total
            </button>

            <button
              type="button"
              class="supporter-tab"
              data-support-tab="amount"
              aria-pressed="false"
            >
              Amount
            </button>
          </nav>
        </header>

        <div class="supporter-table">
          <!-- Recent -->
          <div
            class="supporter-view"
            data-support-view="recent"
          >
            <div
              class="supporter-columns recent-columns"
              aria-hidden="true"
            >
              <span>NAME</span>
              <span>AMOUNT</span>
              <span>TIME</span>
            </div>

            <div class="supporter-rows">
              {recentSupport.map((supporter) => (
                <div class="supporter-row recent-row">
                  <span class="supporter-name">
                    {supporter.name}
                  </span>

                  <span class="supporter-value">
                    ${supporter.amount.toFixed(2)}
                  </span>

                  <span class="supporter-time">
                    {supporter.time}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Total -->
          <div
            class="supporter-view"
            data-support-view="total"
            hidden
          >
            <div
              class="supporter-columns ranking-columns"
              aria-hidden="true"
            >
              <span>NAME</span>
              <span>DONATIONS</span>
            </div>

            <div class="supporter-rows">
              {totalSupport.map((supporter, index) => (
                <div class="supporter-row ranking-row">
                  <span class="supporter-rank">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <span class="supporter-name">
                    {supporter.name}
                  </span>

                  <span class="supporter-value">
                    {supporter.value}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Amount -->
          <div
            class="supporter-view"
            data-support-view="amount"
            hidden
          >
            <div
              class="supporter-columns ranking-columns"
              aria-hidden="true"
            >
              <span>NAME</span>
              <span>AMOUNT</span>
            </div>

            <div class="supporter-rows">
              {amountSupport.map((supporter, index) => (
                <div class="supporter-row ranking-row">
                  <span class="supporter-rank">
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  <span class="supporter-name">
                    {supporter.name}
                  </span>

                  <span class="supporter-value">
                    ${supporter.value.toFixed(2)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Tree -->
      <section
        class="tree-panel"
        aria-label="Support tree visualization"
      >
        <div class="tree-placeholder">
          <span aria-hidden="true">
            {`                 *
                /|\\
               / | \\
              /  |  \\
             / \\ | / \\
            /___\\|/___\\
                ||
                ||
               /  \\
              /____\\`}
          </span>

          <p>TREE VISUAL / DEVELOPMENT PLACEHOLDER</p>
        </div>
      </section>
    </section>

    <!-- Right Side -->
    <section class="support-content-panel">
      <div class="support-content">
        <header class="support-header">
          <h1>Support</h1>

          <span>PHOXY / FOX</span>
        </header>

        <div class="support-copy">
          <p>
            If you enjoy the stuff I make and want to help me keep making more of it,
            you can support me here.
          </p>

          <p>
            Support is completely optional. More ways to support and the actual
            payment infrastructure will live here later.
          </p>
        </div>

        <div class="support-placeholder">
          <span>SUPPORT METHODS / DEVELOPMENT</span>
        </div>
      </div>

      <PageNav
        first={{
          label: 'Links',
          href: '/links',
          icon: 'link',
        }}
        second={{
          label: 'Home',
          href: '/',
          icon: 'house',
        }}
      />
    </section>
  </main>
</Layout>

<script>
  /*
   * SUPPORTER VIEW SWITCHER
   */

  const tabs =
    document.querySelectorAll<HTMLButtonElement>(
      '[data-support-tab]'
    );

  const views =
    document.querySelectorAll<HTMLElement>(
      '[data-support-view]'
    );

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const selectedView =
        tab.dataset.supportTab;

      if (!selectedView) {
        continue;
      }

      for (const otherTab of tabs) {
        const isSelected =
          otherTab === tab;

        otherTab.classList.toggle(
          'is-active',
          isSelected
        );

        otherTab.setAttribute(
          'aria-pressed',
          String(isSelected)
        );
      }

      for (const view of views) {
        view.hidden =
          view.dataset.supportView !==
          selectedView;
      }
    });
  }
</script>

<style>
  /*
   * PAGE
   */

  .support-page {
    display: grid;
    grid-template-columns: 1fr 1fr;

    width: 100%;
    min-height: 100vh;

    background: var(--color-bg);
    color: var(--color-fg);
  }

  /*
   * LEFT SIDE
   */

  .support-visual-panel {
    display: grid;
    grid-template-rows:
      minmax(0, 0.4fr)
      minmax(0, 0.6fr);

    min-width: 0;
    min-height: 100vh;

    border-right:
      1px
      solid
      var(--color-border);
  }

  /*
   * SUPPORTER DISPLAY
   */

  .supporters {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 0;

    overflow: hidden;

    border-bottom:
      1px
      solid
      var(--color-border);
  }

  .supporters-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 1rem;

    width: 100%;

    padding: 0.65rem 0.75rem;

    border-bottom:
      1px
      solid
      var(--color-border);
  }

  .supporters-header > span {
    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.7rem;
    font-weight: 700;

    letter-spacing: 0.04em;
  }

  /*
   * VIEW BUTTONS
   */

  .supporter-tabs {
    display: flex;
    align-items: center;

    gap: 1rem;
  }

  .supporter-tab {
    position: relative;

    padding: 0;

    border: 0;

    background: transparent;
    color: var(--color-fg);

    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.7rem;
    font-weight: 700;

    cursor: pointer;
  }

  .supporter-tab::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -0.2rem;

    width: 100%;
    height: 1px;

    background: currentColor;

    transform: scaleX(0);
    transform-origin: left;

    transition:
      transform
      0.1s
      ease-out;
  }

  .supporter-tab:hover::after,
  .supporter-tab:focus-visible::after,
  .supporter-tab.is-active::after {
    transform: scaleX(1);
  }

  /*
   * TABLE AREA
   */

  .supporter-table {
    min-width: 0;
    min-height: 0;

    overflow-y: auto;

    scrollbar-width: thin;
  }

  .supporter-view {
    width: 100%;
  }

  .supporter-view[hidden] {
    display: none;
  }

  /*
   * COLUMN LABELS
   */

  .supporter-columns {
    position: sticky;
    top: 0;
    z-index: 2;

    width: 100%;

    padding:
      0.4rem
      0.75rem;

    border-bottom:
      1px
      solid
      var(--color-border);

    background:
      var(--color-bg);

    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.62rem;
    font-weight: 700;

    opacity: 0.65;
  }

  .recent-columns {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      5rem;

    gap: 1rem;
  }

  .recent-columns span:nth-child(2),
  .recent-columns span:nth-child(3) {
    text-align: right;
  }

  .ranking-columns {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    gap: 1rem;
  }

  .ranking-columns span:last-child {
    text-align: right;
  }

  /*
   * ROWS
   */

  .supporter-row {
    width: 100%;

    padding:
      0.55rem
      0.75rem;

    border-bottom:
      1px
      solid
      var(--color-border);

    font-family:
      "Adwaita Mono",
      monospace;

    font-size:
      clamp(
        0.75rem,
        0.9vw,
        0.95rem
      );

    line-height: 1.1;
  }

  .recent-row {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      5rem;

    gap: 1rem;

    align-items: baseline;
  }

  .ranking-row {
    display: grid;

    grid-template-columns:
      2rem
      minmax(0, 1fr)
      auto;

    gap: 0.75rem;

    align-items: baseline;
  }

  .supporter-name {
    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .supporter-value,
  .supporter-time {
    text-align: right;
    white-space: nowrap;
  }

  .supporter-rank {
    opacity: 0.45;
  }

  /*
   * TREE
   */

  .tree-panel {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    min-width: 0;
    min-height: 0;

    overflow: hidden;
  }

  .tree-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 1.5rem;

    padding: 2rem;

    text-align: center;
  }

  .tree-placeholder > span {
    display: block;

    margin: 0;

    color: var(--color-fg);

    font-family:
      "Adwaita Mono",
      monospace;

    font-size:
      clamp(
        0.8rem,
        1.5vw,
        1.35rem
      );

    line-height: 1;

    white-space: pre;

    opacity: 0.85;
  }

  .tree-placeholder p {
    margin: 0;

    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.65rem;
    font-weight: 700;

    opacity: 0.45;
  }

  /*
   * RIGHT SIDE
   */

  .support-content-panel {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 100vh;
  }

  .support-content {
    width: 100%;

    padding: 0.75rem;
  }

  /*
   * SUPPORT HEADER
   */

  .support-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 1rem;

    margin-bottom:
      clamp(
        4rem,
        10vh,
        8rem
      );
  }

  .support-header h1 {
    margin: 0;

    font-family:
      "Space Grotesk Variable",
      sans-serif;

    font-size:
      clamp(
        5rem,
        9vw,
        10rem
      );

    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
  }

  .support-header span {
    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.75rem;
    font-weight: 700;
  }

  /*
   * TEMPORARY CONTENT
   */

  .support-copy {
    display: flex;
    flex-direction: column;

    gap: 1rem;

    max-width: 32rem;
  }

  .support-copy p {
    margin: 0;

    font-family:
      "Inter Variable",
      sans-serif;

    font-size:
      clamp(
        1.25rem,
        1.75vw,
        1.8rem
      );

    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .support-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 8rem;

    margin-top: 3rem;

    border:
      1px
      solid
      var(--color-border);
  }

  .support-placeholder span {
    font-family:
      "Adwaita Mono",
      monospace;

    font-size: 0.65rem;
    font-weight: 700;

    opacity: 0.45;
  }

  /*
   * REDUCED MOTION
   */

  @media (prefers-reduced-motion: reduce) {
    .supporter-tab::after {
      transition: none;
    }
  }

  /*
   * MOBILE
   */

  @media (max-width: 700px) {
    .support-page {
      grid-template-columns: 1fr;
    }

    .support-content-panel {
      order: 1;

      min-height: 100vh;
    }

    .support-visual-panel {
      order: 2;

      grid-template-rows:
        minmax(20rem, auto)
        minmax(30rem, 70vh);

      min-height: 0;

      border-top:
        1px
        solid
        var(--color-border);

      border-right: 0;
    }

    .support-header {
      margin-bottom: 4rem;
    }

    .support-header h1 {
      font-size:
        clamp(
          4.5rem,
          22vw,
          8rem
        );
    }

    .supporters {
      min-height: 20rem;
    }

    .supporters-header {
      align-items: flex-start;
      flex-direction: column;

      gap: 0.75rem;
    }

    .supporter-tabs {
      width: 100%;

      justify-content: space-between;
    }

    .recent-columns,
    .recent-row {
      grid-template-columns:
        minmax(0, 1fr)
        auto
        4.5rem;

      gap: 0.65rem;
    }

    .tree-panel {
      min-height: 30rem;
    }
  }
</style>